ocery store.","Ata restaurant."],"answer":"D","explanation":"Đáp án: Ata restaurant.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-9","passage":null,"confidence":"verified"},{"id":"D3-069","set":"D3","n":69,"part":3,"q":"How often does the man go to this place?","options":["Every day.","Every two days.","Once a week.","Once a month."],"answer":"C","explanation":"Đáp án: Once a week.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-9","passage":null,"confidence":"verified"},{"id":"D3-070","set":"D3","n":70,"part":3,"q":"What will the man get?","options":["Soup.","Rice.","Chicken.","Sandwiches."],"answer":"C","explanation":"Đáp án: Chicken.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-9","passage":null,"confidence":"verified"},{"id":"D3-071","set":"D3","n":71,"part":4,"q":"Who is listening to this announcement?","options":["Company employees.","Doctors.","Parents of schoolchildren.","Police officers."],"answer":"A","explanation":"Đáp án: Company employees.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-10","passage":null,"confidence":"verified"},{"id":"D3-072","set":"D3","n":72,"part":4,"q":"What has been revised?","options":["Doctors’ excuses.","Insurance regulations.","Company policy.","Employees’ records."],"answer":"C","explanation":"Đáp án: Company policy.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-10","passage":null,"confidence":"verified"},{"id":"D3-073","set":"D3","n":73,"part":4,"q":"When is a note required?","options":["Within forty-eight hours.","After four days.","After a week.","Never."],"answer":"D","explanation":"Đáp án: Never.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-10","passage":null,"confidence":"verified"},{"id":"D3-074","set":"D3","n":74,"part":4,"q":"What is happening?","options":["Some people need a hotel room.","Some people are going home.","The personnel office is closing.","A building is on fire."],"answer":"D","explanation":"Đáp án: A building is on fire.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-11","passage":null,"confidence":"verified"},{"id":"D3-075","set":"D3","n":75,"part":4,"q":"Who must get through?","options":["Office personnel.","Emergency personnel.","Clerical workers.","File clerks."],"answer":"B","explanation":"Đáp án: Emergency personnel.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-11","passage":null,"confidence":"verified"},{"id":"D3-076","set":"D3","n":76,"part":4,"q":"Where should people stay?","options":["Next to a room","Across the street","Beside the building","In the emergency room"],"answer":"B","explanation":"Đáp án: Across the street.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-11","passage":null,"confidence":"verified"},{"id":"D3-077","set":"D3","n":77,"part":4,"q":"What kind of program is mentioned?","options":["Race","Space","Tasting","Waste"],"answer":"B","explanation":"","group":"77","passage":null,"confidence":"verified"},{"id":"D3-078","set":"D3","n":78,"part":4,"q":"Which of the following animals is mentioned?","options":["A dog","A cat","A sheep","A rat"],"answer":"A","explanation":"","group":"78","passage":null,"confidence":"verified"},{"id":"D3-079","set":"D3","n":79,"part":4,"q":"How many times has this program been done before?","options":["None","Once","Twice","Several times"],"answer":"A","explanation":"","group":"79","passage":null,"confidence":"verified"},{"id":"D3-080","set":"D3","n":80,"part":4,"q":"How is the president described in the news report?","options":["As a mother","As a doctor","As a father","As a general"],"answer":"C","explanation":"","group":"80","passage":null,"confidence":"verified"},{"id":"D3-081","set":"D3","n":81,"part":4,"q":"How many children does the president have?","options":["Two","Three","Four","Five"],"answer":"A","explanation":"","group":"81","passage":null,"confidence":"verified"},{"id":"D3-082","set":"D3","n":82,"part":4,"q":"When did the event happen?","options":["Yesterday","This morning","At noon","In the early evening"],"answer":"B","explanation":"Đáp án: Space.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-13","passage":null,"confidence":"verified"},{"id":"D3-083","set":"D3","n":83,"part":4,"q":"What is being sold?","options":["A watch","A television","A calendar","A guide"],"answer":"B","explanation":"","group":"83","passage":null,"confidence":"verified"},{"id":"D3-084","set":"D3","n":84,"part":4,"q":"How long does the subscription last?","options":["Ten days","One month","Ten months","One year"],"answer":"D","explanation":"","group":"84","passage":null,"confidence":"verified"},{"id":"D3-085","set":"D3","n":85,"part":4,"q":"How many people can get the special offer?","options":["One","The first ten","The first one hundred","There is no limit"],"answer":"B","explanation":"","group":"85","passage":null,"confidence":"verified"},{"id":"D3-086","set":"D3","n":86,"part":4,"q":"What is the problem?","options":["No one is home","The line is busy","It is a nonworking number","The caller hung up"],"answer":"C","explanation":"","group":"86","passage":null,"confidence":"verified"},{"id":"D3-087","set":"D3","n":87,"part":4,"q":"What is the listener advised to do?","options":["Give up","Get another job","Not to hang up","Try again"],"answer":"D","explanation":"","group":"87","passage":null,"confidence":"verified"},{"id":"D3-088","set":"D3","n":88,"part":4,"q":"What can a caller do by dialing 411?","options":["Check the number he is dialing","Ask for a refund check","Get assistance with dialing the number","Ask to have his phone number changed"],"answer":"A","explanation":"Đáp án: A watch.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-15","passage":null,"confidence":"verified"},{"id":"D3-089","set":"D3","n":89,"part":4,"q":"What is the weather like now?","options":["Rainy","Cool","Warm","Windy"],"answer":"C","explanation":"","group":"89","passage":null,"confidence":"verified"},{"id":"D3-090","set":"D3","n":90,"part":4,"q":"When will the weather change?","options":["Sunday","Monday","Tuesday","Friday"],"answer":"A","explanation":"","group":"90","passage":null,"confidence":"verified"},{"id":"D3-091","set":"D3","n":91,"part":4,"q":"How much rain is expected?","options":["Two inches","Three inches","Four inches","Twenty-four inches"],"answer":"C","explanation":"","group":"91","passage":null,"confidence":"verified"},{"id":"D3-092","set":"D3","n":92,"part":4,"q":"What is on sale?","options":["Chairs","Desks","Paper","Pencils"],"answer":"C","explanation":"","group":"92","passage":null,"confidence":"verified"},{"id":"D3-093","set":"D3","n":93,"part":4,"q":"What color is NOT available?","options":["Blue","Yellow","Green","White"],"answer":"B","explanation":"","group":"93","passage":null,"confidence":"verified"},{"id":"D3-094","set":"D3","n":94,"part":4,"q":"When will the sale end?","options":["Sunday","Tuesday","Friday","Saturday"],"answer":"D","explanation":"Đáp án: Rainy. Cool. Warm. Windy. When will the weather change? (A) (B) (C) (D) Sunday. Monday. Tuesday. Friday. How much rain is expected? (A) (B) (C) (D) Two inches. Three inches. Four inches. Twenty-four inches. What is on sa. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-17","passage":null,"confidence":"verified"},{"id":"D3-095","set":"D3","n":95,"part":4,"q":"What was robbed?","options":["A clothing store","A jewelry store","A computer store","A watch store"],"answer":"B","explanation":"Đáp án: Ajewelry store.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-18","passage":null,"confidence":"verified"},{"id":"D3-096","set":"D3","n":96,"part":4,"q":"What time did the robbery happen?","options":["8:05","8:15","8:50","8:55"],"answer":"D","explanation":"Đáp án: 8:55.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-18","passage":null,"confidence":"verified"},{"id":"D3-097","set":"D3","n":97,"part":4,"q":"Who was in the store at the time of the robbery?","options":["Police","Customers","The store staff","The store owner"],"answer":"D","explanation":"Đáp án: The store owner. Stop! This is the end of the Listenin 272 PRACTICE TEST ONE. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-18","passage":null,"confidence":"verified"},{"id":"D3-098","set":"D3","n":98,"part":4,"q":"When is the Sidewalk Café closed?","options":["Monday","Tuesday","Saturday","Sunday"],"answer":"A","explanation":"Đáp án: Monday.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-19","passage":null,"confidence":"verified"},{"id":"D3-099","set":"D3","n":99,"part":4,"q":"What can you get for $6.00 at the café?","options":["Birthday cake","Pancakes","Steak","Pans"],"answer":"B","explanation":"Đáp án: Pancakes.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-19","passage":null,"confidence":"verified"},{"id":"D3-100","set":"D3","n":100,"part":4,"q":"Where is the café located?","options":["By a river","In back of a park","Near a bus station","Close to a subway station"],"answer":"D","explanation":"Đáp án: Close to a subway station. g test. Turn to Part 5 in your test book.. Đối chiếu với ngữ cảnh và loại trừ các lựa chọn không phù hợp.","group":"D3-listen-19","passage":null,"confidence":"verified"},{"id":"D3-101","set":"D3","n":101,"part":5,"q":"East Coast Airlines flight number 15 from New York _____ Chicago has been canceled.","options":["to","in","by","at"],"answer":"A","explanation":"From New York to Chicago: from ... to ... (từ ... đến ...).","group":"101","passage":null,"confidence":"verified"},{"id":"D3-102","set":"D3","n":102,"part":5,"q":"Beginning the first of next month, lunch breaks will be _____ by fifteen minutes.","options":["short","shortened","shortening","shortage"],"answer":"B","explanation":"Will be + past participle: câu bị động tương lai.","group":"102","passage":null,"confidence":"verified"},{"id":"D3-103","set":"D3","n":103,"part":5,"q":"The computer programmer realized he had forgotten to turn off the office lights _____ he had left the premises.","options":["after","because","since","and"],"answer":"A","explanation":"After + clause: sau khi hành động xảy ra.","group":"103","passage":null,"confidence":"verified"},{"id":"D3-104","set":"D3","n":104,"part":5,"q":"Most employees have requested that their paychecks be _____ to their homes.","options":["mail","mails","mailed","mailing"],"answer":"C","explanation":"Request that + S + be + V3: giả định/mệnh lệnh trong tiếng Anh trang trọng.","group":"104","passage":null,"confidence":"verified"},{"id":"D3-105","set":"D3","n":105,"part":5,"q":"The error was noticed after Ms. Radice _____ the order to the supply company.","options":["had sent in","sends in","has sent","is sending"],"answer":"A","explanation":"Past perfect để chỉ một hành động diễn ra trước một hành động quá khứ.","group":"105","passage":null,"confidence":"verified"},{"id":"D3-106","set":"D3","n":106,"part":5,"q":"Mr. Richards, the president of Capo Electronics, has had a very _____ year.","options":["successfully","successful","success","successes"],"answer":"B","explanation":"Each/every + danh từ số ít, động từ ngôi thứ ba số ít.","group":"106","passage":null,"confidence":"verified"},{"id":"D3-107","set":"D3","n":107,"part":5,"q":"Since Dr. Yamoto is always busy, it is best to call _____ make an appointment before coming to her office.","options":["while","before","nor","and"],"answer":"D","explanation":"Before + V-ing / before + clause: trước khi làm gì.","group":"107","passage":null,"confidence":"verified"},{"id":"D3-108","set":"D3","n":108,"part":5,"q":"After working fifteen hours at the office, the new lawyer is finally putting away his papers and heading _____.","options":["homely","homey","home","homeless"],"answer":"C","explanation":"Home/house/homeless: phân biệt trạng từ chỉ nơi chốn và tính từ.","group":"108","passage":null,"confidence":"verified"},{"id":"D3-109","set":"D3","n":109,"part":5,"q":"The photographer that we hired to take pictures of the banquet will be accompanied _____ his assistant.","options":["with","by","to","from"],"answer":"B","explanation":"Accompany + someone = đi cùng ai; không dùng kèm with ngay sau accompany.","group":"109","passage":null,"confidence":"verified"},{"id":"D3-110","set":"D3","n":110,"part":5,"q":"Ms. Ueki has never made any _____ decisions regarding the operation of her company.","options":["foolish","fool","foolishness","fooled"],"answer":"A","explanation":"Make decisions: đưa ra quyết định; danh từ đếm được số nhiều.","group":"110","passage":null,"confidence":"verified"},{"id":"D3-111","set":"D3","n":111,"part":5,"q":"As soon as we _____ the cause of the problem, we will be able to solve it.","options":["assign","determine","signify","confer"],"answer":"B","explanation":"As soon as + mệnh đề, dùng dạng động từ phù hợp chủ ngữ.","group":"111","passage":null,"confidence":"verified"},{"id":"D3-112","set":"D3","n":112,"part":5,"q":"In order to provide her customers with the finest meals, the restaurant owner _____ her produce fresh daily.","options":["buy","buys","buying","bought"],"answer":"B","explanation":"To provide + người + with something: cung cấp cái gì cho ai.","group":"112","passage":null,"confidence":"verified"},{"id":"D3-113","set":"D3","n":113,"part":5,"q":"The personnel manager needs someone to _____ her with the presentation to the board.","options":["attend","assume","assign","assist"],"answer":"D","explanation":"Need someone to assist + somebody: cần người hỗ trợ.","group":"113","passage":null,"confidence":"verified"},{"id":"D3-114","set":"D3","n":114,"part":5,"q":"Our departmental staff meetings are held _____ in the conference room on the third floor.","options":["rarely","every week","always","sometimes"],"answer":"B","explanation":"Every week / weekly diễn đạt tính định kỳ của một hoạt động.","group":"114","passage":null,"confidence":"verified"},{"id":"D3-115","set":"D3","n":115,"part":5,"q":"The building is equipped with a sophisticated security system which turns on automatically _____ midnight.","options":["to","from","at","for"],"answer":"C","explanation":"Automatically là trạng từ bổ nghĩa cho turns on.","group":"115","passage":null,"confidence":"verified"},{"id":"D3-116","set":"D3","n":116,"part":5,"q":"The project _____ to require more time than the contractors have available.","options":["had seemed","seems","is seeming","will seem"],"answer":"B","explanation":"The project will seem ...: sau will dùng nguyên mẫu.","group":"116","passage":null,"confidence":"verified"},{"id":"D3-117","set":"D3","n":117,"part":5,"q":"Staff members _____ ready to help out new employees and explain the office procedures.","options":["should always be","being always should","always be should","always should being"],"answer":"A","explanation":"Always + hiện tại đơn chỉ thói quen và trạng từ thường ở trước động từ chính.","group":"117","passage":null,"confidence":"verified"},{"id":"D3-118","set":"D3","n":118,"part":5,"q":"The new schedules are _____ with the second shift workers at the factory.","options":["popularized","popular","populated","popularity"],"answer":"B","explanation":"Popular with + nhóm người: được ưa chuộng với.","group":"118","passage":null,"confidence":"verified"},{"id":"D3-119","set":"D3","n":119,"part":5,"q":"It was agreed that the committee meet again _____ the tenth of April.","options":["for","on","to","from"],"answer":"B","explanation":"On + ngày tháng cụ thể (on the tenth of April).","group":"119","passage":null,"confidence":"verified"},{"id":"D3-120","set":"D3","n":120,"part":5,"q":"The travel agent said she would know the flight number and the precise arrival time _____ the airlines confirmed the reservation.","options":["during","because","when","while"],"answer":"C","explanation":"During + noun phrase: trong suốt khoảng thời gian.","group":"120","passage":null,"confidence":"verified"},{"id":"D3-121","set":"D3","n":121,"part":5,"q":"You will have to _____ an operator's manual from the library because I don't think we have one here.","options":["loan","borrow","lend","send"],"answer":"B","explanation":"Borrow + vật from người/nơi, lend + vật to người.","group":"121","passage":null,"confidence":"verified"},{"id":"D3-122","set":"D3","n":122,"part":5,"q":"The height of this chair is _____, so you can change it if it's not high enough for you.","options":["adjustable","reliable","suitable","comfortable"],"answer":"A","explanation":"Comfortable: tính từ, sau cấu trúc “is ...”.","group":"122","passage":null,"confidence":"verified"},{"id":"D3-123","set":"D3","n":123,"part":5,"q":"The assistant does not recall receiving a telex from the Mexico office _____ from the South American office.","options":["either","and","or","but"],"answer":"C","explanation":"But: liên từ biểu thị sự đối lập giữa hai ý.","group":"123","passage":null,"confidence":"verified"},{"id":"D3-124","set":"D3","n":124,"part":5,"q":"_____ this kind of machine before, or should we call in a repairperson?","options":["Have ever you repaired","Have you repaired ever","Ever have you repaired","Have you ever repaired"],"answer":"D","explanation":"Have you ever + past participle: hiện tại hoàn thành hỏi trải nghiệm.","group":"124","passage":null,"confidence":"verified"},{"id":"D3-125","set":"D3","n":125,"part":5,"q":"If our office _____ a coffee machine, Mr. Perkins said he would make coffee every morning.","options":["had","have","will have","would have"],"answer":"A","explanation":"Would have + V3: hệ quả giả định ở quá khứ.","group":"125","passage":null,"confidence":"verified"},{"id":"D3-126","set":"D3","n":126,"part":5,"q":"The time sheets are to be filled out twice _____—in the morning when the staff arrives and in the evening when they leave.","options":["usually","sometimes","daily","frequently"],"answer":"C","explanation":"Usually: trạng từ chỉ tần suất.","group":"126","passage":null,"confidence":"verified"},{"id":"D3-127","set":"D3","n":127,"part":5,"q":"Because of the _____ in the value of local real estate, investors are looking for other ways to invest their money.","options":["diminish","decline","down","weaker"],"answer":"B","explanation":"Diminish in value: giảm giá trị; collocation.","group":"127","passage":null,"confidence":"verified"},{"id":"D3-128","set":"D3","n":128,"part":5,"q":"The goal of our meetings is to make the directors _____ our problem.","options":["understanding","understood","understand","be understanding"],"answer":"C","explanation":"Understanding: danh động từ giữ vai trò bổ nghĩa/định ngữ.","group":"128","passage":null,"confidence":"verified"},{"id":"D3-129","set":"D3","n":129,"part":5,"q":"_____ Mr. Park was the only one who knew the way to the conference, he drove the car.","options":["Although","Since","But","Therefore"],"answer":"B","explanation":"Although: mặc dù; biểu thị tương phản.","group":"129","passage":null,"confidence":"verified"},{"id":"D3-130","set":"D3","n":130,"part":5,"q":"Ms. Wang did not want her check automatically _____ into her account.","options":["deposit","deposits","depositing","deposited"],"answer":"D","explanation":"Deposit an amount into an account: nộp tiền vào tài khoản.","group":"130","passage":null,"confidence":"verified"},{"id":"D3-131","set":"D3","n":131,"part":5,"q":"If this package is sent by the express mail service, it _____ California by Friday.","options":["reaches","will reach","reached","is reaching"],"answer":"B","explanation":"Be reaching: hình thức đang tiến tới kết quả tương lai theo ngữ cảnh.","group":"131","passage":null,"confidence":"verified"},{"id":"D3-132","set":"D3","n":132,"part":5,"q":"All delivery persons are asked to use the side _____ to make their deliveries.","options":["enter","entered","entering","entrance"],"answer":"D","explanation":"Enter + room/building: động từ chuyển động không cần giới từ.","group":"132","passage":null,"confidence":"verified"},{"id":"D3-133","set":"D3","n":133,"part":5,"q":"Hotel guests who _____ checking out after 1:00 P.M. should contact the front desk.","options":["will","were","are going","will be"],"answer":"D","explanation":"Will be + V-ing / động từ to be diễn tả hành động tương lai.","group":"133","passage":null,"confidence":"verified"},{"id":"D3-134","set":"D3","n":134,"part":5,"q":"Mr. Davis, my lawyer, was a _____ by the time he was thirty.","options":["millions","millionaire","million","millionfold"],"answer":"B","explanation":"Millionaire: triệu phú; phân biệt million = một triệu.","group":"134","passage":null,"confidence":"verified"},{"id":"D3-135","set":"D3","n":135,"part":5,"q":"If the accountant _____ a mistake, she will not charge us for her time.","options":["makes","will make","had made","make"],"answer":"A","explanation":"Will make a mistake: cấu trúc giả định kết quả trong tương lai.","group":"135","passage":null,"confidence":"verified"},{"id":"D3-136","set":"D3","n":136,"part":5,"q":"That position has been _____ for over a month, but we've finally hired someone to fill it.","options":["taken","required","dismissed","vacant"],"answer":"D","explanation":"Has been vacant for over a month: hiện tại hoàn thành trạng thái.","group":"136","passage":null,"confidence":"verified"},{"id":"D3-137","set":"D3","n":137,"part":5,"q":"We are fortunate to have a company president who is quite _____ about computers.","options":["knowing","knowledge","knowledgeable","knows"],"answer":"C","explanation":"Knowledgeable about: có hiểu biết về.","group":"137","passage":null,"confidence":"verified"},{"id":"D3-138","set":"D3","n":138,"part":5,"q":"Yasmin is one of our best employees and _____ working here for two years.","options":["has","has been","is","will"],"answer":"B","explanation":"Has been working for two years: hiện tại hoàn thành tiếp diễn.","group":"138","passage":null,"confidence":"verified"},{"id":"D3-139","set":"D3","n":139,"part":5,"q":"The receptionist _____ the vice president if he knew where she was.","options":["will call","call","called","would call"],"answer":"C","explanation":"Would call: lùi thì trong lời nói gián tiếp.","group":"139","passage":null,"confidence":"verified"},{"id":"D3-140","set":"D3","n":140,"part":5,"q":"Because we are unusually busy right now, the department head has asked everyone to _____ their vacations until later in the year.","options":["defer","confer","refer","infer"],"answer":"A","explanation":"Defer vacations: trì hoãn kỳ nghỉ.","group":"140","passage":null,"confidence":"verified"},{"id":"D3-141","set":"D3","n":141,"part":6,"q":"I have taken a new job in Sydney. My family and I will move _____ next month.","options":["there","that","here","it"],"answer":"A","explanation":"Move there: chuyển đến đó; there chỉ địa điểm.","group":"D3-p141","passage":"D3-p141","confidence":"verified"},{"id":"D3-142","set":"D3","n":142,"part":6,"q":"We would like to rent a small house in a nice _____ neighborhood.","options":["industrial","residential","influential","commercial"],"answer":"B","explanation":"Residential neighborhood: khu dân cư.","group":"D3-p141","passage":"D3-p141","confidence":"verified"},{"id":"D3-143","set":"D3","n":143,"part":6,"q":"I plan to visit your city in two weeks _____ for a house.","options":["look","looking","to look","will look"],"answer":"C","explanation":"To look for + N: chỉ mục đích đi tìm.","group":"D3-p141","passage":"D3-p141","confidence":"verified"},{"id":"D3-144","set":"D3","n":144,"part":6,"q":"Welcome to the Sleepwell Motel. We hope _____ stay is a pleasant one.","options":["our","his","your","their"],"answer":"C","explanation":"Your stay: kỳ lưu trú của quý khách.","group":"D3-p144","passage":"D3-p144","confidence":"verified"},{"id":"D3-145","set":"D3","n":145,"part":6,"q":"If you need assistance, please _____ 09 to speak to someone at the front desk.","options":["mark","dial","count","register"],"answer":"B","explanation":"Please dial 09: quay số điện thoại.","group":"D3-p144","passage":"D3-p144","confidence":"verified"},{"id":"D3-146","set":"D3","n":146,"part":6,"q":"A _____ breakfast is available to all motel guests in the lobby.","options":["compliment","complimented","complimenting","complimentary"],"answer":"D","explanation":"Complimentary breakfast: bữa sáng miễn phí.","group":"D3-p144","passage":"D3-p144","confidence":"verified"},{"id":"D3-147","set":"D3","n":147,"part":6,"q":"... so that the guests will be able to hear the speeches _____.","options":["ease","easy","easier","easily"],"answer":"D","explanation":"Easy to hear: dễ nghe rõ.","group":"D3-p147","passage":"D3-p147","confidence":"verified"},{"id":"D3-148","set":"D3","n":148,"part":6,"q":"Does your hotel provide assistance with decorating, or will we need _____ a separate decorator?","options":["hire","hires","to hire","hiring"],"answer":"C","explanation":"Hiring a decorator: thuê người trang trí.","group":"D3-p147","passage":"D3-p147","confidence":"verified"},{"id":"D3-149","set":"D3","n":149,"part":6,"q":"Please send me a price list including rental _____ for the room...","options":["fees","dates","leases","agents"],"answer":"A","explanation":"Offer accommodations: cung cấp chỗ lưu trú.","group":"D3-p147","passage":"D3-p147","confidence":"verified"},{"id":"D3-150","set":"D3","n":150,"part":6,"q":"Cango has been the leading _____ of new and used cars in the Canmore area.","options":["retailer","insurer","automobiles","mechanic"],"answer":"A","explanation":"Car retailer: nhà bán lẻ xe hơi.","group":"D3-p150","passage":"D3-p150","confidence":"verified"},{"id":"D3-151","set":"D3","n":151,"part":6,"q":"We pride _____ in being all we can to prevent dangerous cars from getting back onto our roads.","options":["ourselves","yourself","yourselves","itself"],"answer":"A","explanation":"Protect yourselves: đại từ phản thân chỉ người mua số nhiều.","group":"D3-p150","passage":"D3-p150","confidence":"verified"},{"id":"D3-152","set":"D3","n":152,"part":6,"q":"...and making sure our customers feel secure with the cars they choose. There is nothing more important to us than _____.","options":["upholstery","safety","earnings","collisions"],"answer":"B","explanation":"Safety: danh từ chỉ an toàn.","group":"D3-p150","passage":"D3-p150","confidence":"verified"},{"id":"D3-153","set":"D3","n":153,"part":7,"q":"For whom is this report important?","options":["Weather reporters","Bus riders","City workers","Bus repair people"],"answer":"B","explanation":"Báo lịch xe buýt đổi đường vì diễu hành nên hữu ích nhất cho hành khách xe buýt.","group":"D3-p153","passage":"D3-p153","confidence":"verified"},{"id":"D3-154","set":"D3","n":154,"part":7,"q":"At10:00 a.M., what will happen to certain buses?","options":["They will be used in the parade.","They will take a different route.","They will have no riders.","They will be taken out of service."],"answer":"B","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “They will take a different route.”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p153","passage":"D3-p153","confidence":"verified"},{"id":"D3-155","set":"D3","n":155,"part":7,"q":"When will the parade take place if it rains?","options":["Inthe morning","Inthe afternoon","The next morning","The following afternoon"],"answer":"B","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Inthe afternoon”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p153","passage":"D3-p153","confidence":"verified"},{"id":"D3-156","set":"D3","n":156,"part":7,"q":"What does the memo concern?","options":["Overdue accounts","Office furniture","Supply requests","Computers"],"answer":"C","explanation":"Memo explains how to order supplies.","group":"D3-p156","passage":"D3-p156","confidence":"verified"},{"id":"D3-157","set":"D3","n":157,"part":7,"q":"What will happen to handwritten requests?","options":["They will not be accepted.","They will be approved quickly.","They will be read carefully.","They will be sent to Accounting."],"answer":"A","explanation":"Only typed requests will be accepted.","group":"D3-p156","passage":"D3-p156","confidence":"verified"},{"id":"D3-158","set":"D3","n":158,"part":7,"q":"The word “approved” in paragraph 1, line 11, is closest in meaning to","options":["urgent","valid","signed","accepted"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “accepted”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p156","passage":"D3-p156","confidence":"verified"},{"id":"D3-159","set":"D3","n":159,"part":7,"q":"What will happen to approved requests?","options":["They will be returned to the employee.","They will be sent to Purchasing.","They will be forwarded to Accounting.","They will be returned to R. Wettimuny."],"answer":"C","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “They will be forwarded to Accounting.”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p156","passage":"D3-p156","confidence":"verified"},{"id":"D3-160","set":"D3","n":160,"part":7,"q":"What is the cost of sending a twelve-gram letter to South Africa?","options":["¥70","¥90","¥130","¥230"],"answer":"C","explanation":"Nam Phi thuộc Zone 3; thư 12g: giá ¥130 theo bảng.","group":"D3-p160","passage":"D3-p160","confidence":"verified"},{"id":"D3-161","set":"D3","n":161,"part":7,"q":"How much would an aerogramme to Asia cost?","options":["¥70","¥90","¥110","¥160"],"answer":"B","explanation":"Aerogramme có một mức giá chung ¥90 cho toàn thế giới.","group":"D3-p160","passage":"D3-p160","confidence":"verified"},{"id":"D3-162","set":"D3","n":162,"part":7,"q":"How much will a ¥110 letter to Europe weigh?","options":["25 grams or less","Between 25 and 50 grams","More than 50 grams","Unknown"],"answer":"A","explanation":"Zone 2 letter tới 25g = ¥110.","group":"D3-p160","passage":"D3-p160","confidence":"verified"},{"id":"D3-163","set":"D3","n":163,"part":7,"q":"A passenger traveling in which of the following would read this bulletin?","options":["Plane","Car","Bus","Train"],"answer":"D","explanation":"Bulletin refers to train cars and coaches.","group":"D3-p163","passage":"D3-p163","confidence":"verified"},{"id":"D3-164","set":"D3","n":164,"part":7,"q":"For which of the following are reservations required?","options":["The dining car","First-class car","Second-class car","Third-class car"],"answer":"B","explanation":"Reservations are required for all first-class compartments.","group":"D3-p163","passage":"D3-p163","confidence":"verified"},{"id":"D3-165","set":"D3","n":165,"part":7,"q":"According to the passage, which of the following have dining cars?","options":["All trains","Trains with first-class cars","Trains with second-class cars","Trains with third-class cars"],"answer":"B","explanation":"Trains that do not have first-class cars do not have a dining car.","group":"D3-p163","passage":"D3-p163","confidence":"verified"},{"id":"D3-166","set":"D3","n":166,"part":7,"q":"The word “Additional” in paragraph 3, line 2, is closest in meaning to","options":["Most","Extra","Overweight","Large"],"answer":"B","explanation":"Additional = extra.","group":"D3-p163","passage":"D3-p163","confidence":"verified"},{"id":"D3-167","set":"D3","n":167,"part":7,"q":"Where does Mr. Goodwin probably live?","options":["India","Sri Lanka","Australia","Malaysia"],"answer":"C","explanation":"The letterhead says Sydney, Australia.","group":"D3-p167","passage":"D3-p167","confidence":"verified"},{"id":"D3-168","set":"D3","n":168,"part":7,"q":"What does Mrs. Mangala manufacture?","options":["Jewelry","Fashions","Textiles","Toys"],"answer":"A","explanation":"She operates a jewelry exporting business.","group":"D3-p167","passage":"D3-p167","confidence":"verified"},{"id":"D3-169","set":"D3","n":169,"part":7,"q":"The word “line” in paragraph 1, line 1, is closest in meaning to","options":["bag","straight","design","type"],"answer":"D","explanation":"Product line = dòng/chủng loại sản phẩm.","group":"D3-p167","passage":"D3-p167","confidence":"verified"},{"id":"D3-170","set":"D3","n":170,"part":7,"q":"Where will the jewelry be exported from?","options":["India","Australia","Malaysia","Sri Lanka"],"answer":"D","explanation":"Người bán ở Sri Lanka, hàng xuất đi từ Sri Lanka.","group":"D3-p167","passage":"D3-p167","confidence":"verified"},{"id":"D3-171","set":"D3","n":171,"part":7,"q":"Which of the following best describes Mrs. Mangala’s gems?","options":["High-quality","Inexpensive","Uncut","Tax-free"],"answer":"A","explanation":"The London associates were impressed with their quality.","group":"D3-p167","passage":"D3-p167","confidence":"verified"},{"id":"D3-172","set":"D3","n":172,"part":7,"q":"From what will this spray protect shoes?","options":["Dirt","Dust","Water","Drying out"],"answer":"C","explanation":"Waterproof means protect from water.","group":"D3-p172","passage":"D3-p172","confidence":"verified"},{"id":"D3-173","set":"D3","n":173,"part":7,"q":"How many times must the shoes be sprayed?","options":["One time","Two times","Six times","Eight times"],"answer":"B","explanation":"Apply once and repeat application one more time.","group":"D3-p172","passage":"D3-p172","confidence":"verified"},{"id":"D3-174","set":"D3","n":174,"part":7,"q":"How long will the application last?","options":["One hour","One week","A couple of months","Half a year"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Acouple of months”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p172","passage":"D3-p172","confidence":"verified"},{"id":"D3-175","set":"D3","n":175,"part":7,"q":"How many teachers responded to the survey?","options":["20","40","43","76"],"answer":"C","explanation":"Khảo sát có tổng 43 giáo viên tham gia.","group":"D3-p175","passage":"D3-p175","confidence":"verified"},{"id":"D3-176","set":"D3","n":176,"part":7,"q":"What was the reason given most often for the lack of computer education in schools?","options":["Poor-quality software","Not enough computers","Fear of computers","Expense"],"answer":"D","explanation":"Too expensive has the highest count (20).","group":"D3-p175","passage":"D3-p175","confidence":"verified"},{"id":"D3-177","set":"D3","n":177,"part":7,"q":"Which of the following do teachers consider the least problematic?","options":["Cost of computers","Quality of software","Fear of computers","Time in curriculum"],"answer":"C","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Fear of computers”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p175","passage":"D3-p175","confidence":"verified"},{"id":"D3-178","set":"D3","n":178,"part":7,"q":"What did Mr. Ng do?","options":["Wrote an essay","Asked for more money","Turned down a prize","Announced his retirement"],"answer":"A","explanation":"He won for the essay titled The Hotel Family.","group":"D3-p178","passage":"D3-p178","confidence":"verified"},{"id":"D3-179","set":"D3","n":179,"part":7,"q":"When was the award winner announced?","options":["Last year","Last night","This morning","This afternoon"],"answer":"B","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Last year”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p178","passage":"D3-p178","confidence":"verified"},{"id":"D3-180","set":"D3","n":180,"part":7,"q":"What is Mr. Ng’s advice?","options":["Get your own promotion first","Have more children","Bea better parent","Help others be successful"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Have more children”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p178","passage":"D3-p178","confidence":"verified"},{"id":"D3-181","set":"D3","n":181,"part":7,"q":"How many shows are there at the theater on Saturday?","options":["One","Two","Four","Five"],"answer":"B","explanation":"Lịch National Theater: Saturday matinée 1 suất và evening 1 suất, tổng 2.","group":"D3-p181","passage":"D3-p181","confidence":"verified"},{"id":"D3-182","set":"D3","n":182,"part":7,"q":"What does Mr. Stein want tickets for?","options":["Aplay","Amovie","A lecture","Aconcert"],"answer":"A","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Amovie”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p181","passage":"D3-p181","confidence":"verified"},{"id":"D3-183","set":"D3","n":183,"part":7,"q":"How many people work in Mr. Stein’s department?","options":["10","15","20","25"],"answer":"B","explanation":"Email nêu nhóm ít nhất 15 người, chọn 15.","group":"D3-p181","passage":"D3-p181","confidence":"verified"},{"id":"D3-184","set":"D3","n":184,"part":7,"q":"When does Mr. Stein want to go to the theater?","options":["March 12","March 13","March 21","March 29"],"answer":"A","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “March 13”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p181","passage":"D3-p181","confidence":"verified"},{"id":"D3-185","set":"D3","n":185,"part":7,"q":"How does Mr. Stein plan to get to the theater?","options":["By bus","By car","By foot","By subway"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “By bus”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p181","passage":"D3-p181","confidence":"verified"},{"id":"D3-186","set":"D3","n":186,"part":7,"q":"Why did Mr. Schmidt write the letter?","options":["To open a new bank account","To report a stolen credit card","To find out his account balance","To get information about his debit card"],"answer":"D","explanation":"He asks about liability if his card is stolen.","group":"D3-p186","passage":"D3-p186","confidence":"verified"},{"id":"D3-187","set":"D3","n":187,"part":7,"q":"How long has Mr. Schmidt been banking at Union Bank?","options":["For 48 hours","For one week","For a little less than 15 years","For more than 15 years"],"answer":"D","explanation":"He has been a customer for over 15 years.","group":"D3-p186","passage":"D3-p186","confidence":"verified"},{"id":"D3-188","set":"D3","n":188,"part":7,"q":"Where can Mr. Schmidt find the information he needs?","options":["On the back of his debit card","In a booklet of bank rules","On his account statement","In his checkbook"],"answer":"B","explanation":"Personal Accounts booklet, page 39.","group":"D3-p186","passage":"D3-p186","confidence":"verified"},{"id":"D3-189","set":"D3","n":189,"part":7,"q":"What is probably Elena Ugarte’s job?","options":["Customer service representative","Credit card specialist","Loan officer","Teller"],"answer":"A","explanation":"Người trả lời thư ngân hàng ký Elena Ugarte, nhân viên chăm sóc khách hàng.","group":"D3-p186","passage":"D3-p186","confidence":"verified"},{"id":"D3-190","set":"D3","n":190,"part":7,"q":"What did Ms. Ugarte enclose in the letter?","options":["A new debit card","A copy of a page","A bill for $50","A photograph"],"answer":"B","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Acopy ofa page”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p186","passage":"D3-p186","confidence":"verified"},{"id":"D3-191","set":"D3","n":191,"part":7,"q":"What is Mr. Takubo’s job?","options":["Landlord","Accountant","Real estate agent","Personal assistant"],"answer":"C","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Real estate agent”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p191","passage":"D3-p191","confidence":"verified"},{"id":"D3-192","set":"D3","n":192,"part":7,"q":"What kind of office does Ms. Choi want?","options":["Large","Quiet","Expensive","Convenient"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Convenient”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p191","passage":"D3-p191","confidence":"verified"},{"id":"D3-193","set":"D3","n":193,"part":7,"q":"What is the rent on the State Street office?","options":["$500","$1,500","$2,000","$2,500"],"answer":"D","explanation":"Email trả lời giá State Street $500/tháng.","group":"D3-p191","passage":"D3-p191","confidence":"verified"},{"id":"D3-194","set":"D3","n":194,"part":7,"q":"When will the State Street office be available?","options":["Right now","Tomorrow","By the end of this month","At the end of next month"],"answer":"C","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “By the end of this month”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p191","passage":"D3-p191","confidence":"verified"},{"id":"D3-195","set":"D3","n":195,"part":7,"q":"What time does Mr. Takubo want to meet with Ms. Choi?","options":["7:30","9:00","11:00","11:30"],"answer":"C","explanation":"Trong email M. Takubo đề nghị gặp lúc 7:30.","group":"D3-p191","passage":"D3-p191","confidence":"verified"},{"id":"D3-196","set":"D3","n":196,"part":7,"q":"What kind of job is Joe applying for?","options":["Accountant","Software engineer","Human resources director","Customer account representative"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Customer account representative”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p196","passage":"D3-p196","confidence":"verified"},{"id":"D3-197","set":"D3","n":197,"part":7,"q":"What should job applicants send to Ms Ahmad?","options":["Arésumé","Abilling statement","A letter of recommendation","Acopy of their college diploma"],"answer":"A","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Arésumé”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p196","passage":"D3-p196","confidence":"verified"},{"id":"D3-198","set":"D3","n":198,"part":7,"q":"Where does Joe work now?","options":["For a magazine","For a French company","For a mail order company","For a cable television provider"],"answer":"C","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Fora mail order company”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p196","passage":"D3-p196","confidence":"verified"},{"id":"D3-199","set":"D3","n":199,"part":7,"q":"How long has Joe had his current job?","options":["Two years","Three years","Four years","Five years"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “Four years”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p196","passage":"D3-p196","confidence":"verified"},{"id":"D3-200","set":"D3","n":200,"part":7,"q":"What field is Joe’s college degree in?","options":["Computer science","Communications","Accounting","French"],"answer":"D","explanation":"Từ khóa hoặc dữ kiện trong bài đọc dẫn đến lựa chọn “French . If you finish before time is called, you 7 and check your work.”. Nên đối chiếu trực tiếp câu chứa thông tin, tránh chọn đáp án có từ giống nhưng sai ý.","group":"D3-p196","passage":"D3-p196","confidence":"verified"},{"id":"D4-101","set":"D4","n":101,"part":5,"q":"I will call you as soon as I_______","options":["arrive","arrives","was arriving","will arrive"],"answer":"A","explanation":"Mệnh đề thời gian (as soon as) dùng thì hiện tại đơn để chỉ tương lai.","group":"D4-101","passage":null,"confidence":"ok"},{"id":"D4-102","set":"D4","n":102,"part":5,"q":"We will have to ________ strictly to meet expenses this month.","options":["economy","economize","economist","economical"],"answer":"B","explanation":"Sau 'to' cần động từ nguyên thể: economize (tiết kiệm chi tiêu).","group":"D4-102","passage":null,"confidence":"ok"},{"id":"D4-103","set":"D4","n":103,"part":5,"q":"You'll find the ink cartridges ______ the top shelf of the closet.","options":["in","on","up","at"],"answer":"B","explanation":"On the shelf: trên kệ. Dùng 'on' với bề mặt phẳng.","group":"D4-103","passage":null,"confidence":"ok"},{"id":"D4-104","set":"D4","n":104,"part":5,"q":"The missing document was _______ in an empty office.","options":["discover","discovery","discovered","discovering"],"answer":"C","explanation":"Was discovered: thì quá khứ bị động (be + V3).","group":"D4-104","passage":null,"confidence":"ok"},{"id":"D4-105","set":"D4","n":105,"part":5,"q":"This report is urgent, so please turn it ______ before the end of the day.","options":["on","up","in","over"],"answer":"C","explanation":"Turn in = nộp (submit). Phrasal verb phù hợp ngữ cảnh.","group":"D4-105","passage":null,"confidence":"ok"},{"id":"D4-106","set":"D4","n":106,"part":5,"q":"If you need any help filling out the forms, __________ somebody at the front desk for assistance.","options":["to ask","asking","asks","ask"],"answer":"D","explanation":"Câu mệnh lệnh dùng động từ nguyên thể không 'to': ask somebody.","group":"D4-106","passage":null,"confidence":"ok"},{"id":"D4-107","set":"D4","n":107,"part":5,"q":"We will need to think _______ in order to find a good solution to this problem.","options":["creatively","creative","created","creator"],"answer":"A","explanation":"Trạng từ (adverb) bổ nghĩa cho động từ 'think': think creatively.","group":"D4-107","passage":null,"confidence":"ok"},{"id":"D4-108","set":"D4","n":108,"part":5,"q":"This office is expensive, but it's _______ than our old office.","options":["space","spacious","more spacious","the most spacious"],"answer":"C","explanation":"So sánh hơn với tính từ dài (2+ âm tiết): more spacious.","group":"D4-108","passage":null,"confidence":"ok"},{"id":"D4-109","set":"D4","n":109,"part":5,"q":"Dr. Chin, __________ book I just showed you, works across the hall from me.","options":["who","that","whom","whose"],"answer":"D","explanation":"Whose = sở hữu cách trong mệnh đề quan hệ: whose book.","group":"D4-109","passage":null,"confidence":"ok"},{"id":"D4-110","set":"D4","n":110,"part":5,"q":"The new company headquarters is _________ Main Street.","options":["at","on","in","to"],"answer":"B","explanation":"On + tên đường: located on Main Street.","group":"D4-110","passage":null,"confidence":"ok"},{"id":"D4-111","set":"D4","n":111,"part":5,"q":"I really enjoy the work that I do, ________ I have a hard time getting along with my colleagues.","options":["but","and","as","or"],"answer":"A","explanation":"But nối hai mệnh đề tương phản (enjoy work vs. hard time with colleagues).","group":"D4-111","passage":null,"confidence":"ok"},{"id":"D4-112","set":"D4","n":112,"part":5,"q":"We returned the table to the store because we _____ a small flaw on the surface.","options":["demanded","deplored","detected","delayed"],"answer":"C","explanation":"Detected = phát hiện ra (khuyết điểm nhỏ trên bề mặt).","group":"D4-112","passage":null,"confidence":"ok"},{"id":"D4-113","set":"D4","n":113,"part":5,"q":"The old house on the corner is ________ down and needs some serious repair work.","options":["fell","falls","fallen","falling"],"answer":"D","explanation":"Is falling down: đang sụp đổ (hiện tại tiếp diễn mô tả trạng thái).","group":"D4-113","passage":null,"confidence":"ok"},{"id":"D4-114","set":"D4","n":114,"part":5,"q":"I will need these documents for the meeting tomorrow, so please have them on my desk _______ 8:00","options":["before","between","on","in"],"answer":"A","explanation":"Before 8:00: trước 8 giờ (chỉ mốc thời gian hạn chót).","group":"D4-114","passage":null,"confidence":"ok"},{"id":"D4-115","set":"D4","n":115,"part":5,"q":"The visitor we are expecting in a few days _________ help finding a good hotel.","options":["need","needs","have needed","are going to need"],"answer":"B","explanation":"The visitor (số ít) → needs (chia ngôi 3 số ít hiện tại đơn).","group":"D4-115","passage":null,"confidence":"ok"},{"id":"D4-116","set":"D4","n":116,"part":5,"q":"The _______ of our manufacturing process has saved the company a lot of money.","options":["simplification","simplify","simply","simple"],"answer":"A","explanation":"Danh từ làm chủ ngữ: simplification (sự đơn giản hóa).","group":"D4-116","passage":null,"confidence":"ok"},{"id":"D4-117","set":"D4","n":117,"part":5,"q":"Ms. Lee prepared the charts, ________ Ms. Kim presented them at the meeting.","options":["or","during","and","of"],"answer":"C","explanation":"And nối hai mệnh đề bổ sung nhau (Lee prepared, Kim presented).","group":"D4-117","passage":null,"confidence":"ok"},{"id":"D4-118","set":"D4","n":118,"part":5,"q":"Everybody employed by this office __________ a professional degree.","options":["has","have","to have","is having"],"answer":"A","explanation":"Everybody là chủ ngữ số ít → has.","group":"D4-118","passage":null,"confidence":"ok"},{"id":"D4-119","set":"D4","n":119,"part":5,"q":"You can expect _______ your first paycheck before the end of your first month of employment.","options":["receive","to receive","receiving","recipient"],"answer":"B","explanation":"Expect + to V: to receive (cấu trúc expect to do something).","group":"D4-119","passage":null,"confidence":"ok"},{"id":"D4-120","set":"D4","n":120,"part":5,"q":"It is better for the economy to buy things that are produced _________ rather than bringing in products from far away.","options":["local","localize","locally","location"],"answer":"C","explanation":"Trạng từ (adverb) bổ nghĩa cho động từ 'produced': produced locally.","group":"D4-120","passage":null,"confidence":"ok"},{"id":"D4-121","set":"D4","n":121,"part":5,"q":"If you _________ your reservations earlier, you would have gotten on the flight you wanted.","options":["made","had made","have made","would have made"],"answer":"B","explanation":"Câu điều kiện loại 3: If + had + V3, would have + V3. Had made.","group":"D4-121","passage":null,"confidence":"ok"},{"id":"D4-122","set":"D4","n":122,"part":5,"q":"The manager let everyone _______ the office early to attend the convention.","options":["left","to leave","leaves","leave"],"answer":"D","explanation":"Let + O + V nguyên mẫu không 'to': let everyone leave.","group":"D4-122","passage":null,"confidence":"ok"},{"id":"D4-123","set":"D4","n":123,"part":5,"q":"The number of people who ask questions at the end of the lecture _______ always quite astonishing.","options":["be","are","were","is"],"answer":"D","explanation":"'The number of' là chủ ngữ số ít → is (khác 'a number of' số nhiều).","group":"D4-123","passage":null,"confidence":"ok"},{"id":"D4-124","set":"D4","n":124,"part":5,"q":"You can sign the document now, __________ you can speak to an attorney first if you prefer.","options":["and","but","or","nor"],"answer":"C","explanation":"Or nối hai lựa chọn (sign now OR speak to attorney first).","group":"D4-124","passage":null,"confidence":"ok"},{"id":"D4-125","set":"D4","n":125,"part":5,"q":"You'll find the letter ________ the papers on my desk.","options":["along","among","almost","always"],"answer":"B","explanation":"Among = ở giữa/trong số (khi xen lẫn vào nhiều vật): among the papers.","group":"D4-125","passage":null,"confidence":"ok"},{"id":"D4-126","set":"D4","n":126,"part":5,"q":"He might _____________ a discount if he pays for his ticket before next week.","options":["get","gets","will get","going to get"],"answer":"A","explanation":"Might + V nguyên mẫu: might get (modal verb).","group":"D4-126","passage":null,"confidence":"ok"},{"id":"D4-127","set":"D4","n":127,"part":5,"q":"If you lived closer to the office, you _____ trouble getting to work on time.","options":["don't have","didn't have","won't have","wouldn't have"],"answer":"D","explanation":"Câu điều kiện loại 2: If + V2, would + V: wouldn't have.","group":"D4-127","passage":null,"confidence":"ok"},{"id":"D4-128","set":"D4","n":128,"part":5,"q":"After listening to this thorough _______, I had no problems understanding how to use the software.","options":["explains","explained","explanation","explanatory"],"answer":"C","explanation":"Danh từ sau tính từ 'thorough': explanation (sự giải thích).","group":"D4-128","passage":null,"confidence":"ok"},{"id":"D4-129","set":"D4","n":129,"part":5,"q":"He had a good reputation and was ______ as a very fair boss.","options":["regarded","registered","regulated","regretted"],"answer":"A","explanation":"Regarded as = được coi là (be regarded as: cấu trúc cố định).","group":"D4-129","passage":null,"confidence":"ok"},{"id":"D4-130","set":"D4","n":130,"part":5,"q":"We will review your application ________ you have submitted all your paperwork.","options":["soon","as soon","as soon as","soon than"],"answer":"C","explanation":"As soon as = ngay khi (liên từ thời gian nối mệnh đề).","group":"D4-130","passage":null,"confidence":"ok"},{"id":"D4-131","set":"D4","n":131,"part":5,"q":"She earns more money than her coworkers ______ she works a lot of overtime hours.","options":["although","because","despite","nevertheless"],"answer":"B","explanation":"Because = vì (chỉ nguyên nhân: làm thêm giờ nên thu nhập cao hơn).","group":"D4-131","passage":null,"confidence":"ok"},{"id":"D4-132","set":"D4","n":132,"part":5,"q":"Prices continue to __________, causing a great deal of financial difficulty.","options":["up","high","raise","rise"],"answer":"D","explanation":"Rise (nội động từ) = tăng lên (prices rise, không có tân ngữ).","group":"D4-132","passage":null,"confidence":"ok"},{"id":"D4-133","set":"D4","n":133,"part":5,"q":"The walls were painted this morning, so _____ them.","options":["touch","don't touch","touching","not to touch"],"answer":"B","explanation":"Mệnh lệnh phủ định: Don't touch (đừng chạm vào).","group":"D4-133","passage":null,"confidence":"ok"},{"id":"D4-134","set":"D4","n":134,"part":5,"q":"The list of registered guests __________ sitting on the manager's desk.","options":["have","were","are","is"],"answer":"D","explanation":"'The list' là chủ ngữ số ít → is (không phải 'guests').","group":"D4-134","passage":null,"confidence":"ok"},{"id":"D4-135","set":"D4","n":135,"part":5,"q":"Mr. Sato __________ here for many years and is one of our most knowledgeable employees.","options":["is working","used to work","has been working","will have worked"],"answer":"C","explanation":"Has been working: hiện tại hoàn thành tiếp diễn (bắt đầu từ quá khứ, còn tiếp diễn).","group":"D4-135","passage":null,"confidence":"ok"},{"id":"D4-136","set":"D4","n":136,"part":5,"q":"Ms. Hansen got the job ________ she has very little experience and no college degree.","options":["because","even though","moreover","since"],"answer":"B","explanation":"Even though = mặc dù (tương phản: ít kinh nghiệm nhưng vẫn được nhận).","group":"D4-136","passage":null,"confidence":"ok"},{"id":"D4-137","set":"D4","n":137,"part":5,"q":"We can't work on a solution until we ______ the source of the problem.","options":["identification","indemnify","identity","identify"],"answer":"D","explanation":"Identify = xác định (động từ cần thiết sau 'we' và 'until').","group":"D4-137","passage":null,"confidence":"ok"},{"id":"D4-138","set":"D4","n":138,"part":5,"q":"We discussed __________ a temporary assistant to help out with the extra work.","options":["hire","hired","hiring","to hire"],"answer":"C","explanation":"Discuss + V-ing: discuss hiring (không dùng to V).","group":"D4-138","passage":null,"confidence":"ok"},{"id":"D4-139","set":"D4","n":139,"part":5,"q":"Very few people showed ________ for the conference.","options":["up","to","off","through"],"answer":"A","explanation":"Show up = xuất hiện/đến tham dự (phrasal verb cố định).","group":"D4-139","passage":null,"confidence":"ok"},{"id":"D4-140","set":"D4","n":140,"part":5,"q":"The ________ of this business is a result of a lot of hard work and some solid financial support.","options":["success","successful","succeed","successfully"],"answer":"A","explanation":"Danh từ làm chủ ngữ: success (sự thành công).","group":"D4-140","passage":null,"confidence":"ok"},{"id":"D5-101","set":"D5","n":101,"part":5,"q":"We need a ________ person like Mr. Griegs working for our company.","options":["decide","decision","decisive","decisively"],"answer":"C","explanation":"decisive (adj) = quyết đoán, bổ nghĩa cho danh từ 'person'.","group":"D5-101","passage":null,"confidence":"ok"},{"id":"D5-102","set":"D5","n":102,"part":5,"q":"If you pay the entire bill before the end of the month, they ________ you any interest.","options":["don't charge","won't charge","aren't charging","wouldn't charge"],"answer":"B","explanation":"Câu điều kiện loại 1: If + hiện tại đơn → will + V. won't charge.","group":"D5-102","passage":null,"confidence":"ok"},{"id":"D5-103","set":"D5","n":103,"part":5,"q":"You cannot put ________ that task any longer; it needs to be done before the end of this week.","options":["on","up","off","out"],"answer":"C","explanation":"put off = trì hoãn (phrasal verb). put off a task = hoãn công việc.","group":"D5-103","passage":null,"confidence":"ok"},{"id":"D5-104","set":"D5","n":104,"part":5,"q":"Mr. Sterling was very unhappy to hear about Peter's absence from the meeting and made certain to ________ him for it.","options":["reprove","improve","approve","disprove"],"answer":"A","explanation":"reprove = kiển trách, quở trách. Phù hợp ngữ cảnh 'unhappy about absence'.","group":"D5-104","passage":null,"confidence":"ok"},{"id":"D5-105","set":"D5","n":105,"part":5,"q":"We had to go into the office and finish up work on the report ________ it was a Saturday.","options":["therefore","because","since","even though"],"answer":"D","explanation":"even though = mặc dù (tương phản: phải vào làm dù là thứ Bảy).","group":"D5-105","passage":null,"confidence":"ok"},{"id":"D5-106","set":"D5","n":106,"part":5,"q":"You can just leave your hat and gloves ________ the closet shelf and proceed to the conference room.","options":["in","between","on","though"],"answer":"C","explanation":"on the shelf = trên kệ (dùng 'on' với bề mặt phẳng).","group":"D5-106","passage":null,"confidence":"ok"},{"id":"D5-107","set":"D5","n":107,"part":5,"q":"When I arrived at the Emergency Responders meeting, coffee ________.","options":["was serving","was being served","served","had served"],"answer":"B","explanation":"was being served: quá khứ tiếp diễn bị động (coffee không tự phục vụ).","group":"D5-107","passage":null,"confidence":"ok"},{"id":"D5-108","set":"D5","n":108,"part":5,"q":"We overspent our budget last year, so we really need to ________ this year.","options":["economy","economize","economics","economist"],"answer":"B","explanation":"Sau 'to' cần động từ nguyên thể: economize = tiết kiệm chi tiêu.","group":"D5-108","passage":null,"confidence":"ok"},{"id":"D5-109","set":"D5","n":109,"part":5,"q":"________she got this job, she worked for a large company on the West Coast.","options":["Before","First","Prior","Earlier"],"answer":"A","explanation":"Before + mệnh đề: trước khi có việc này, cô ấy làm ở West Coast.","group":"D5-109","passage":null,"confidence":"ok"},{"id":"D5-110","set":"D5","n":110,"part":5,"q":"Sam has contributed a lot to the company since he started working here, and I think we should consider ________ him a raise.","options":["give","given","giving","to give"],"answer":"C","explanation":"consider + V-ing: consider giving (không dùng to V sau consider).","group":"D5-110","passage":null,"confidence":"ok"},{"id":"D5-111","set":"D5","n":111,"part":5,"q":"Because of the company's expansion, several new employees ________ over the next few months.","options":["hire","will hire","are hiring","will be hired"],"answer":"D","explanation":"will be hired: tương lai bị động (employees được thuê, không tự thuê).","group":"D5-111","passage":null,"confidence":"ok"},{"id":"D5-112","set":"D5","n":112,"part":5,"q":"I think you will find that your staff will do the extra work more ________ if you provide a bonus.","options":["read","reading","ready","readily"],"answer":"D","explanation":"readily (adv) = sẵn sàng, vui vẻ; bổ nghĩa cho động từ 'do'.","group":"D5-112","passage":null,"confidence":"ok"},{"id":"D5-113","set":"D5","n":113,"part":5,"q":"We kept on interviewing candidates________ we found the right person for the job.","options":["after","because","until","although"],"answer":"C","explanation":"until = cho đến khi (tiếp tục phỏng vấn cho đến khi tìm được người phù hợp).","group":"D5-113","passage":null,"confidence":"ok"},{"id":"D5-114","set":"D5","n":114,"part":5,"q":"________ is very important in my office, so I try never to arrive late.","options":["Punctual","Punctually","Punctuate","Punctuality"],"answer":"D","explanation":"Punctuality (danh từ) = sự đúng giờ; làm chủ ngữ của câu.","group":"D5-114","passage":null,"confidence":"ok"},{"id":"D5-115","set":"D5","n":115,"part":5,"q":"Everyone ________ extra hours at the moment until the project is completed.","options":["works","is working","had worked","work"],"answer":"B","explanation":"is working: hiện tại tiếp diễn (at the moment = ngay lúc này).","group":"D5-115","passage":null,"confidence":"ok"},{"id":"D5-116","set":"D5","n":116,"part":5,"q":"If you are unhappy with your work situation, you need to ________ your dissatisfaction to your boss.","options":["express","repress","impress","oppress"],"answer":"A","explanation":"express dissatisfaction = bày tỏ sự không hài lòng (express = nói ra).","group":"D5-116","passage":null,"confidence":"ok"},{"id":"D5-117","set":"D5","n":117,"part":5,"q":"We ________ all this office furniture from a discount vendor last year, and he gave us a very good price.","options":["purchased","revived","polished","rejected"],"answer":"A","explanation":"purchased = mua (past simple); phù hợp với 'last year'.","group":"D5-117","passage":null,"confidence":"ok"},{"id":"D5-118","set":"D5","n":118,"part":5,"q":"He usually ends up disappointed because his ________ are too high.","options":["expects","expect","expectant","expectations"],"answer":"D","explanation":"expectations (danh từ số nhiều) = kỳ vọng (his expectations are too high).","group":"D5-118","passage":null,"confidence":"ok"},{"id":"D5-119","set":"D5","n":119,"part":5,"q":"The interns who worked with us last summer ________ very helpful.","options":["was","were","are","is"],"answer":"B","explanation":"The interns (số nhiều) + past tense (last summer) → were.","group":"D5-119","passage":null,"confidence":"ok"},{"id":"D5-120","set":"D5","n":120,"part":5,"q":"His business wasn't at all ________ and he lost a great deal of money.","options":["comparable","fallible","agreeable","profitable"],"answer":"D","explanation":"profitable = sinh lợi, có lãi; phù hợp ngữ cảnh mất nhiều tiền.","group":"D5-120","passage":null,"confidence":"ok"},{"id":"D5-121","set":"D5","n":121,"part":5,"q":"Everyone was late for the meeting ________ the traffic was so terrible.","options":["although","but","because","despite"],"answer":"C","explanation":"because + mệnh đề: vì (tắc đường → đến muộn).","group":"D5-121","passage":null,"confidence":"ok"},{"id":"D5-122","set":"D5","n":122,"part":5,"q":"You could ________ your boss to get someone to help you with this extra work.","options":["to ask","asking","ask","will ask"],"answer":"C","explanation":"could + V nguyên thể: could ask (modal verb không dùng 'to').","group":"D5-122","passage":null,"confidence":"ok"},{"id":"D5-123","set":"D5","n":123,"part":5,"q":"They ________ to look for new clients after the first of the year.","options":["intern","intact","intend","intake"],"answer":"C","explanation":"intend to do something = dự định làm gì (intend + to V).","group":"D5-123","passage":null,"confidence":"ok"},{"id":"D5-124","set":"D5","n":124,"part":5,"q":"He ________ drives his car to work because he doesn't like dealing with the traffic in the city.","options":["never","always","usually","mostly"],"answer":"A","explanation":"never (phủ định): vì không thích tắc đường → không bao giờ lái xe.","group":"D5-124","passage":null,"confidence":"ok"},{"id":"D5-125","set":"D5","n":125,"part":5,"q":"We will need to call your references in order to ________ the information you included in your job application.","options":["conform","confirm","conflict","confine"],"answer":"B","explanation":"confirm information = xác nhận thông tin (confirm = kiểm chứng).","group":"D5-125","passage":null,"confidence":"ok"},{"id":"D5-126","set":"D5","n":126,"part":5,"q":"If you had told me you were coming, I ________ the documents ready for you.","options":["would have had","will have","had had","have had"],"answer":"A","explanation":"Điều kiện loại 3: If + had V3, would have + V3. would have had.","group":"D5-126","passage":null,"confidence":"ok"},{"id":"D5-127","set":"D5","n":127,"part":5,"q":"They hope ________ the report well before next Friday's deadline.","options":["finish","to finish","finishing","will finish"],"answer":"B","explanation":"hope + to V: hope to finish (hope to do something).","group":"D5-127","passage":null,"confidence":"ok"},{"id":"D5-128","set":"D5","n":128,"part":5,"q":"They took the bus ________ New York, and arrived there in about five hours.","options":["in","at","to","by"],"answer":"C","explanation":"take the bus to [place]: đi xe buýt đến New York (chỉ hướng/điểm đến).","group":"D5-128","passage":null,"confidence":"ok"},{"id":"D5-129","set":"D5","n":129,"part":5,"q":"If you are not happy with the agenda, we can ________ the order of the presentations.","options":["vary","variable","variety","variation"],"answer":"A","explanation":"vary (v) = thay đổi, biến đổi; sau 'can' cần động từ nguyên thể.","group":"D5-129","passage":null,"confidence":"ok"},{"id":"D5-130","set":"D5","n":130,"part":5,"q":"________ have to be signed by all parties involved or they are not valid.","options":["Contract","The contract","A contract","Contracts"],"answer":"D","explanation":"Contracts (số nhiều không xác định) = hợp đồng nói chung, ý chỉ quy luật chung.","group":"D5-130","passage":null,"confidence":"ok"},{"id":"D5-131","set":"D5","n":131,"part":5,"q":"You can contact me ________ by e-mail or by telephone.","options":["but","both","either","neither"],"answer":"C","explanation":"either ... or ...: hoặc email hoặc điện thoại (cấu trúc lựa chọn).","group":"D5-131","passage":null,"confidence":"ok"},{"id":"D5-132","set":"D5","n":132,"part":5,"q":"I think you will find that Ms. Lang is ________ on that subject than anyone else in this office.","options":["knowledgeably","knowledgeable","most knowledgeable","more knowledgeable"],"answer":"D","explanation":"So sánh hơn: more knowledgeable than (tính từ dài, dùng more).","group":"D5-132","passage":null,"confidence":"ok"},{"id":"D5-133","set":"D5","n":133,"part":5,"q":"Any ________ merchandise can be returned to the store for a complete refund.","options":["deflective","detective","deductive","defective"],"answer":"D","explanation":"defective = lỗi, khuyết điểm; defective merchandise = hàng bị lỗi.","group":"D5-133","passage":null,"confidence":"ok"},{"id":"D5-134","set":"D5","n":134,"part":5,"q":"They had ________ most of the brochures before anyone else even had a chance to look at them.","options":["take","took","taken","taking"],"answer":"C","explanation":"had taken: quá khứ hoàn thành (had + V3 = taken).","group":"D5-134","passage":null,"confidence":"ok"},{"id":"D5-135","set":"D5","n":135,"part":5,"q":"________ your résumé and references to my assistant before the end of the week.","options":["To give","Give","Giving","Given"],"answer":"B","explanation":"Câu mệnh lệnh: Give (động từ nguyên thể không 'to').","group":"D5-135","passage":null,"confidence":"ok"},{"id":"D5-136","set":"D5","n":136,"part":5,"q":"Jim ________ in the same house since he was a child.","options":["lives","lived","is living","has lived"],"answer":"D","explanation":"has lived: hiện tại hoàn thành (since + quá khứ → hành động từ quá khứ đến hiện tại).","group":"D5-136","passage":null,"confidence":"ok"},{"id":"D5-137","set":"D5","n":137,"part":5,"q":"The rent here is high, but it is ________ office in the building.","options":["the largest","larger","large","enlarge"],"answer":"A","explanation":"the largest: so sánh nhất (it is THE largest office = văn phòng lớn nhất tòa nhà).","group":"D5-137","passage":null,"confidence":"ok"},{"id":"D5-138","set":"D5","n":138,"part":5,"q":"Your ________ will help us get the work done on time.","options":["cooperate","cooperation","cooperative","cooperatively"],"answer":"B","explanation":"cooperation (danh từ) = sự hợp tác; làm chủ ngữ của câu.","group":"D5-138","passage":null,"confidence":"ok"},{"id":"D5-139","set":"D5","n":139,"part":5,"q":"We thought about ________ extra help but then decided that it wouldn't be necessary.","options":["hire","hiring","to hire","hired"],"answer":"B","explanation":"think about + V-ing: think about hiring (giới từ 'about' + V-ing).","group":"D5-139","passage":null,"confidence":"ok"},{"id":"D5-140","set":"D5","n":140,"part":5,"q":"The suits in this store ________ much less than those other suits, and the quality is just the same.","options":["cost","price","money","bill"],"answer":"A","explanation":"cost (v) = có giá, tốn; The suits cost less (động từ nguyên thể làm vị ngữ).","group":"D5-140","passage":null,"confidence":"ok"}],"passages":[{"id":"D1-p141","set":"D1","title":"Bank letter – HTCD Bank","body":"HTCD Bank · 20 State Street · Trenton, New Jersey 08625\nJune 17, 20__\nMs. Nukket Topal · 451 West Huron Drive · Chicago, Illinois 60239\n\nDear Ms. Topal:\nWe received your e-mail requesting to close your savings account. Unfortunately, we are unable to [141] ______ with the request because it was sent by e-mail.\n\nTo close your account, please mail us a letter stating that you wish to close your savings account. Don’t forget to include your sixteen-digit account number and the mailing address where you would like to receive your remaining balance. You can also close your account by visiting our nearest branch.\n\nWe always strive to give our customers the best possible service. We hope that you have been happy with [142] ______ and will consider using our bank again in the future. If you are closing your account because you have had an [143] ______ experience, please contact our customer service representatives to discuss how we can serve you better.\n\nIf we may be of further assistance, please contact us any time. We look forward to working with you.\nSincerely,\nErich Gleisner · Account Manager","table":null,"range":[141,143]},{"id":"D1-p144","set":"D1","title":"E-mail – New office equipment request","body":"From: Marika Fiehne\nTo: Astrid Anderson\nSubject: New office equipment request\n\nThank you for welcoming me to Ontel. My first week working here has been wonderful.\n\nYou asked me to e-mail you about the [144] ______ of my office. Overall, it is very nice and suits most of my needs. However, I would like a few small changes. Could I get a different chair? The current chair is really too small for me. I’d also like a conference table for [145] ______ with clients.\n\nMy office also needs some technology upgrades. The computer’s Internet connection is slow and frequently freezes in the afternoons. It is very frustrating. Also, I don’t have the ability to participate in video teleconferencing. Would it be possible for me to get this? I am expected to participate in weekly conferences with our partners in other countries.\n\nI will need a visit from the IT specialist. I should have antivirus software installed on my computer. Maybe my current computer has it, but I [146] ______ find it.\n\nThank you.","table":null,"range":[144,146]},{"id":"D1-p147","set":"D1","title":"Memo – IT Committee vacancy","body":"From: Sarah Spencer\nTo: Eduardo Allende\nRe: Vacancy on Information Technology Committee\n\nMaria Robles has [147] ______ from her position on the IT Committee.\n\nYou have been recommended to fill the open spot. I hope that you want to participate on this important committee.\n\nYour time commitment would be minimal; however, the [148] ______ is an important one. As you know, criminals have broken into our competitors’ computer systems. These hackers have cost our industry millions in lost and compromised data. To prevent this electronic theft, we have installed anti-hacking measures on our company’s computers. This is one of the IT Committee’s best achievements.\n\nOur company’s sales [149] ______ because news spread about our anti-hacking devices. Customers trust us to protect their financial data.\n\nThe IT Committee agrees that you are our ideal new member. Please consider this invitation and get back to me within the next few days.\n\nThanks.","table":null,"range":[147,149]},{"id":"D1-p150","set":"D1","title":"E-mail – Itinerary","body":"From: Sigmund Ferdinand\nTo: Mendel Wagner\nSubject: Itinerary\n\nDear Mendel,\n\nI wanted to let you know that I booked our train tickets for the upcoming business trip. The price of the tickets was higher than I expected. I don’t know if the train is always so expensive or if this is considered a peak time of year for [150] ______ travel.\n\nIn any case, Waterworks will cover the cost for us.\n\nSince the conference is free [151] ______ charge for all GBC members, Waterworks has offered to put us up in a 5-star hotel. I booked us two single rooms at Champlain Manor. It has a spa, a heated indoor pool, tennis courts, and three restaurants. We definitely won’t be [152] ______ there.\n\nLet me know if you have any questions about these trip plans.\nYours,\nSigmund","table":null,"range":[150,152]},{"id":"D1-p153","set":"D1","title":"Announcement – Yamitomo International","body":"Yamitomo International continues to be a pioneer in the digital revolution. As one of the first companies to manufacture compact discs, we continue to develop and implement the latest techniques.\n\nAt Yamitomo we manufacture compact discs, analog and digital cassettes, and records, as well as CD-ROM, Video CD, CD-I, and we are ready to deliver the next generation of sound carriers. We have carefully built a reputation of excellence in quality and customer service, providing not only manufacturing but also printing, packaging, drop-shipping, marketing, and distribution of music and media products.\n\nWe are ready to provide you with complete factory-to-store shelf service. Our complete wholesale catalog can be viewed online. To order, create your customer account by clicking on “new accounts.” In addition, new accounts can be created and orders made by calling our wholesale customer line at 1-800-555-9098. Online or on the phone, you can always count on the high quality of our products.","table":null,"range":[153,154]},{"id":"D1-p155","set":"D1","title":"Advertisement – Magazine subscriptions","body":"Choose the magazine that meets your sourcing needs better… And get a FREE sample copy!!!\n\nAs a regular or potential importer of Japanese-made electronics, computer products, and components, you know how important the latest marketing information is. You must also be alert to what, where, and how to get the most competitive offers to maintain your competitive edge.\n\nEach of these magazines, Purchasing Components, Purchasing Computer Equipment, and Purchasing Electronics, is published monthly and reports on the Japanese exporting industries in each of these specialized fields. In addition to advertisements, they also contain surveys of new products, corporate and technological developments, details on market changes, and other valuable information to help you in your purchasing decisions.\n\nFill out the Request a Free Sample Copy form on the next page to receive a complimentary copy of the magazine that is right for your business. You will receive your copy in two to four weeks. In order to serve you better, we also ask you to take a few minutes to complete the survey at the bottom of the form. As a thank-you gift, we will send you, absolutely free, a copy of our Guide to Japanese Electronics Companies. This is an exclusive offer made available only to our customers. This book is not available in stores or online.","table":null,"range":[155,156]},{"id":"D1-p157","set":"D1","title":"Letter – Anderson Industries","body":"Dear 25-Year Club Members,\n\nThe massive changes taking place within Anderson Industries may be somewhat unsettling for our longer-term employees. Yet, as we pause to recognize our 25-Year Club members, it is appropriate that we also acknowledge the need to adapt and grow. For this, we need the knowledge and experience of you and of all our employees to guide us successfully through this journey.\n\nMost of you will realize that the manufacturing processes that we utilize and the methods that we use to guide our business have changed very little over the years. In today’s constantly changing world, it is the innovative companies with continuous improvement of flexible manufacturing systems and modern business practices that capture the attention of their customers. This is the kind of company that we are striving to become.\n\nYou are aware that we have been working over the past several months with a team of experts to discuss innovations in our manufacturing processes and business practices. I want to ensure that you are also aware that we have built into this discussion process numerous opportunities to consult with our 25-Year Club members. No one knows better than we do that the perspective gained from experience is an essential part of any innovation process.\n\nAnderson Industries has a solid reputation in the automotive industry, thanks to the efforts of you, the 25-Year Club members. Now it is time for all of us to create the necessary changes in our company to ensure that our 25-Year Club will grow in membership for years to come.\n\nThank you all for your loyalty and commitment to the success of Anderson Industries.\nSincerely,\nKarl Anderson · CEO","table":null,"range":[157,159]},{"id":"D1-p160","set":"D1","title":"Passage – Lake Maracaibo","body":"Flying over Venezuela’s Lake Maracaibo, one is struck by the deep orange color of the water spewing from a river into the lake. This is not a natural phenomenon but the result of aggressive mining practices carried out in western Venezuela, where tons of earth and rock are flushed away every day in the search for valuable diamonds. As the river carries the earth and rock away from the mining areas, it carries it into other areas, most particularly to Lake Maracaibo. Tons of silt flow into the lake every day, with dire consequences for the natural environment and the people who live there. On the one hand, the silting of Lake Maracaibo increases the risk of flooding, thus endangering the lives and livelihoods of people living in the area. In addition, the mining is also destroying fishing grounds that have been a major source of protein food for the country, as well as an important part of the economy.","table":null,"range":[160,161]},{"id":"D1-p162","set":"D1","title":"Notice – Fundraising luncheon","body":"The monthly luncheon meeting of the National Society of Fundraising Executives will be held at noon on Friday, May 5, in the Hall of World Cultures at the Knotty Pines Center, located at 4141 East State Street. The cost is $35 per person. Reservations are due by April 21 and should be sent directly to the Hall of World Cultures at the Knotty Pines Center. Following lunch, there will be a brief membership meeting with committee reports, then we will hear from our guest speaker. This month’s speaker is Miranda Bottomley of Grantwriters, Inc., who will speak on the topic “Tapping into Old Money.” Please note that this event is for members only. All those who are interested in joining the society in time to attend this month’s meeting should contact our membership coordinator, Dr. Kamil Srivastava, at (312) 555-1298 before April 21.","table":null,"range":[162,163]},{"id":"D1-p164","set":"D1","title":"Chart – Mining equipment shipments","body":"Manufacturer’s Value of Shipments of Selected Types of Mining Equipment in the Industry\n\nPlease note: For an analysis of the information on this chart, please see page 10 of this publication. The information on this chart presents shipment values from the past two years. For projected values for the next five years, please see the chart on page 15 of this publication.","table":{"headers":["Type of machinery","First year ($ millions)","Second year ($ millions)","Change"],"rows":[["Portable crushing, pulverizing, and screening machinery","63.7","85.1","+25%"],["Stationary crushing, pulverizing, and screening machinery","160.3","132.1","−18%"],["Underground mining machinery","381.8","318.8","−17%"],["Mineral-processing equipment","90.2","86.6","−4%"],["Portable drilling rigs","295.3","252.8","−14%"],["Mine conveyors, hoists, and locomotives","56.6","82.8","+46%"]]},"range":[164,166]},{"id":"D1-p167","set":"D1","title":"Advertisement – NARTAGAZ Trade Fair","body":"NARTAGAZ · The 10th annual International Trade Fair for Equipment for the Oil & Gas Industry\n\nKorbutt Andropov Park and Fairgrounds, Moscow, Russia\nJune 10–15, 20__\n\nSponsored by: NGJ International GmbH, Stuttgart, Germany\n\nExhibitors and attendees should contact:\nNGJ International\n1151 Park Street\nBaltimore, MD 22899\n(410) 555-9292\n\nExhibitors: Please ask for an application package. Applications due: January 1, 20__.\n\nAttendees: Visitors packages will be available February 1, including a list of exhibit highlights, information on local accommodations, and information on discounted travel and hotel packages.","table":null,"range":[167,169]},{"id":"D1-p170","set":"D1","title":"Advertisement – DynaBold ATMs","body":"Most European financial institutions agree that an ATM is not just a purchase, it is an investment. That is why more than 50 percent of banks that have ATMs have invested in ours.\n\nAt DynaBold we have always built our ATMs to last. But since we are continually developing new technologies, we have made them adaptable, too. Years ago we created the industry’s first modular ATM that could be upgraded without changing the housing. Today these ATMs are still yielding dividends for their original investors.\n\nHowever, we do much more than protect your investment. With more than 100 years of security expertise, we make sure your ATM is secure, too. Our service organization responds 24 hours a day, 365 days a year. Also, all our service engineers are trained to maintain everything from electronic components to security features.\n\nIt is no wonder that the majority of European financial institutions use our ATMs. They know their money is securely invested.\n\nShouldn’t you invest your money wisely, too? Call DynaBold today to find out how. We will arrange to send a DynaBold representative to visit you at your place of business to discuss our complete line of products and show you how a DynaBold ATM system can save you valuable time and money in ways that other ATM systems cannot. Various maintenance and upgrade packages are available. Our representative will help you select the best system and packages to serve your needs. Call today.","table":null,"range":[170,172]},{"id":"D1-p173","set":"D1","title":"Passage – Drug advisory committees","body":"Drug advisory committees report to the Ministry of Health. It is the responsibility of these committees to protect consumers, most of whom have little chemical or biological knowledge with which to evaluate medications. Drug advisory committees provide the Ministry of Health with the necessary information for evaluating the proper degree of access to medications by the consumer. Drug advisory committees also oversee the preparation of materials that provide clearly explained information about commonly available drugs in a manner that is readily understandable to the layperson. Drug education may take the form of literature, advertisements, training of health care personnel, or other means as deemed appropriate by each committee. Drug advisory committees should be composed of physicians, registered nurses, epidemiologists, and pharmacologists. Members must possess specific scientific expertise and must have considerable experience working with consumers so that they can assess the impact of their decisions and projects on consumers. Each committee must have 10–15 members, who will be evaluated every two years by officials from the Ministry of Health.","table":null,"range":[173,176]},{"id":"D1-p177","set":"D1","title":"Advisory – Passports and travel","body":"Having the proper documentation when you travel abroad is very important. Remember that immigration and customs officials are very document-minded, so failing to obtain the proper paperwork before entering a country or losing your passport in a foreign city can cause many complications. When traveling, you should always know where your passport is. Always carry it in a safe place on your person or, if not going far, leave it in the hotel safe. Do not leave it lying about in your hotel room or easily visible in a pocket. If staying in a country for several weeks, it is worthwhile to register at your embassy or consulate. Then, if your passport is stolen, the process of replacing it is simpler and faster. It is also recommended to keep photocopies of essential documents as well as some additional passport-sized photographs.\n\nRemember that it is your responsibility to ensure that your passport is stamped in and out when you cross borders. The absence of entry and exit stamps can cause serious difficulties and could invalidate your visa. Therefore, it is important to seek out the proper officials if the stamping process is not carried out as you cross the border. Also, do not lose your entry card. Replacing it can cause a lot of headaches and expense. Citizens of countries that require visas, such as France and Korea, can expect more delays and problems at border crossings.","table":null,"range":[177,180]},{"id":"D1-p181","set":"D1","title":"Double passage – Computer Center and office memo","body":"LETTER 1 — Lumpkin’s Computer Center\n88 Chestnut Street · Winterdale, MN 90480\nJuly 26, 20__\n\nDear Neighborhood Business,\n\nLumpkin’s Computer Center has just opened in your neighborhood. We offer all the computer supplies you need for your daily business. In addition, we do computer repair and sell refurbished computers. Best of all, we offer a convenient location close to your place of business. Please stop by and find out what we have to offer that will make your work easier. Our specials this week include brand-new printer ink cartridges @ $25 each and computer paper @ $7 for a package of 500 sheets. Show this letter for an additional 10% off your first purchase at Lumpkin’s. See you soon!\n\nYour neighbors,\nRobert and Oscar Lumpkin\n\n———\nMEMO 2 — Holloway & Svenson, Attorneys-at-Law\nFrom: Myra Holloway\nTo: Yoshi Phipps\nRe: Computer Center\n\nPlease look at the attached letter. What a convenience to have a computer supply store on the same block as we are! Why don’t you go today and pick up some things, let’s say 5 ink cartridges and 10 packs of paper. Don’t forget to take the letter with you for the discount. Then you can pop around the corner to Crawford’s Stationery on Maple Avenue for some manila envelopes and anything else you think we need. Thanks.","table":null,"range":[181,185]},{"id":"D1-p186","set":"D1","title":"Double passage – Employment letters","body":"LETTER 1 — September 9, 20__\nMr. T. Sachimoto · Human Resources Director\nThe Spindex Corporation · 1809 35th Street · Mayfield, AL 20812\n\nDear Mr. Sachimoto:\n\nI recently received my master’s degree in Accounting from Pitt University and am currently seeking a position as an accountant. I graduated from Carson College with a bachelor’s degree in Economics and worked for three years as a bookkeeper for Harrison Telemarketing, Inc. before I entered graduate school. I would be interested in applying for any opening you may have for an accountant. I am enclosing my résumé and two letters of reference. I also have copies of my college transcripts available if you are interested in seeing them.\n\nSincerely,\nGina Degenaro\n\n———\nLETTER 2 — September 30, 20__\nMs. Gina Degenaro · 71 Fern Lane · Mayfield, AL 20812\n\nDear Ms. Degenaro:\n\nThank you for your letter expressing interest in working for the Spindex Corporation. You have an impressive background. I was especially interested to see that you went to the same graduate school that I did.\n\nWe generally find that the best way to get a professional position in a large company like Spindex is to begin in one of the lower level jobs. Then you have the opportunity to show what you can do, and when an opening in your field comes up, you are well positioned to apply for it.\n\nWe currently have an opening in our Accounting Department, which you might be interested in applying for. It is for an administrative assistant. If you are interested in such a position, please call my assistant, Ms. Rogers, at 593-555-0954 to set up a time for an interview. When you come in, please bring the documents you mentioned in your letter. I look forward to meeting you.\n\nSincerely,\nT. Sachimoto","table":null,"range":[186,190]},{"id":"D1-p191","set":"D1","title":"Double passage – Akiko Ono’s trip itinerary and e-mail","body":"TRIP ITINERARY FOR AKIKO ONO\n\nE-MAIL\nTo: Tamako Sato\nFrom: Akiko Ono\nSubject: My Trip\nAttach: Itinerary\n\nHello Tamako,\n\nI am attaching the itinerary for my upcoming trip. Please take care of the following for me:\n\n1. I’ll need the photos for the new ad campaign to show at the Global Marketing Conference, but I don’t think they’ll be ready before I leave. I’ll be staying at the Hotel Internationale during the conference. Please send the photos to me there.\n\n2. I will discuss with Ms. Chang the visit she plans to make here. It will be very soon. I’ll call you from her office to let you know the exact dates so you can start getting ready for her.\n\n3. Please note that Mr. Andrews no longer works for Holiday, Inc. Correct his contact information in our files.\n\nThanks.","table":{"headers":["Dates","Place","Activity"],"rows":[["Monday, May 12th","Sydney","Meeting with Mr. Andrews of BelAir Corp."],["Tuesday, May 13th – Wednesday, May 14th","Melbourne","Visit to the offices of Holiday, Inc."],["Thursday, May 15th – Sunday, May 18th","Darwin","Global Marketing Assoc. Conference"],["Monday, May 19th","Singapore","Meeting with Ms. Chang of World Market"],["Tuesday, May 20th","Hong Kong","Visit to Technomarket branch office"],["Wednesday, May 21st","Home","—"]]},"range":[191,195]},{"id":"D1-p196","set":"D1","title":"Double passage – Greendale letters","body":"LETTER 1 — October 17, 20__\nDear Roberto,\n\nI have some interesting news for you. My company is sending me to Greendale to work on a project in our branch office there. I will spend about three months at that branch office. I wondered if you could give me some advice about housing. The office can arrange a hotel for me, but I’d rather find something more comfortable. Since my family won’t be with me, I’ll only need a small apartment. Our office is downtown, right across from Greendale Park, so I’ll need to be able to get there easily by public transportation. I won’t have a car. I would like to pay no more than $1,500 a month. Is that possible in Greendale? I would appreciate any advice you could give me.\n\nI’m also looking forward to seeing you. I plan to stay two weeks after my assignment is finished to travel around the area. I plan to spend most of that time at the beach. Maybe you would like to join me on this vacation. I’ll see you soon.\n\nYour friend,\nLuis Silva\n\n———\nLETTER 2 — October 31, 20__\nDear Luis,\n\nI was very happy to receive your news. I know you’ll enjoy your time in our wonderful city. I have a good recommendation for you. There are several hotels that have special suites that are like small apartments. They all have kitchens and are very comfortable to live in for a few months. They are also inexpensive—about $300 less than the price you said you could pay. All of these hotels are located in the North End of the city. There are hotels in the business district, close to your office, but they don’t have these comfortable suites. I am enclosing some brochures so you can pick the hotel you like the best.\n\nI look forward to seeing you and joining you on the vacation you have planned.\n\nYour friend,\nRoberto Mendez","table":null,"range":[196,200]},{"id":"D2-p141","set":"D2","title":"Reading material – Questions 141–143","body":"MEMO\nTo: All staff\nFrom: D. Rivera\nRe: Office Dress Code\n\nIt has come to our attention that a number of staff members have been coming to work in inappropriate [141]. Please be reminded that this is a place of business and that staff members are expected to dress professionally. This means that casual clothing such as shorts, T-shirts, sandals, and sneakers should not [142] in the office. This is of particular importance when meeting with clients. Remember that each one of you represents the company and needs to keep in mind the impression that you give to clients and potential clients.\n\nIf you have any questions or concerns about this policy, please let [143] know. I will be happy to clarify any issues for you and listen to your concerns. Thank you for your cooperation.","range":[141,143]},{"id":"D2-p144","set":"D2","title":"Reading material – Questions 144–146","body":"As we age, it becomes more and more important to get regular exercise. At the same time, our work lives may become more and more [144]. How can a busy professional find time for exercise in an already overscheduled life? The answer is to exercise a little bit at a time over the course of the day. It all adds up, and you may find that by the end of the day you have gotten thirty minutes of exercise or more just by finding small opportunities here and there.\n\nFor example, [145] you park your car farther away from your office than you normally do, you can get several minutes of walking time in. If you work in a tall building, skip the elevator and take the stairs, at least for part of the way. [146] stairs provides good aerobic exercise. There are many more possibilities.","range":[144,146]},{"id":"D2-p147","set":"D2","title":"Reading material – Questions 147–149","body":"JOB OPPORTUNITIES AT THE SHINDLIN COMPANY\n\nAre you looking for a position that makes full use of your talents and at the same time allows you to grow in your profession? The Shindlin Company, a leading publisher of reference and educational books, provides a dynamic and creative workplace with a full package of benefits and opportunities for [147].\n\nWe are looking for talented professionals with a wide variety of skills. We are also looking for college students and recent college graduates to fill a number of internship positions. We welcome your [148]. Please review the list of job openings below, or submit your resume along with a letter of interest to hr@shindlinco.com. We will contact you when we [149] an opening that matches your skills and background.","range":[147,149]},{"id":"D2-p150","set":"D2","title":"Reading material – Questions 150–152","body":"To: Mi Ja Kim\nFrom: Eun Hee Cho\nSubject: Help with workshop\n\nHello, Ms. Kim,\n\nI am working on the logistics for next week's workshop, and I need some help with planning the lunch. I've looked over the budget, and it appears that we don't have a great deal of money to spend for this. I am having a hard time finding a good [150] service that doesn't charge too much. Can you suggest one that can serve a decent meal at a decent price? I also need your suggestions for a place to serve the lunch. Mr. Song suggested one of the conference rooms, but [151] all seem too small to me.\n\nDo you think we could use the cafeteria? I would really [152] your ideas and suggestions.\n\nThank you very much.\nEun Hee Cho","range":[150,152]},{"id":"D2-p153","set":"D2","title":"Reading material – Questions 153–154","body":"Does Your business need more business?\n\n                        Advertise in the Daily Herald’s Business Directory\n\n                     Your ad will reach over 75,000 readers who need\n                        your services. Carpenters, plumbers, landscapers,\n                          bookkeepers, cleaners, and organizers are just\n                      some of the service providers who have found\n                             advertising in the Daily Herald newspaper to\n                                be a worthwhile investment.\n\n                                   Call 482-9872 to place your ad.\n                          Ads are just $.50 per line per day.","range":[153,154]},{"id":"D2-p155","set":"D2","title":"Reading material – Questions 155–157","body":"The Business and Industry Association will host a meeting to discuss business policy with local government officials next week. This event, which takes place each November, gives business and political leaders the opportunity to discuss business and economic concerns that will have an impact over the coming year, and to set the agenda for the next year's business regulation policy. A summary of the discussion will be provided to all members of the Business and Industry Association as well as to political representatives, and will be reported in this newsletter as well.\n\nThe meeting will take place at the Tinmouth Hotel on November 15 from 9:00 A.M. until noon. After the meeting, a luncheon will be served to all participants. Afterward Dr. Myrtle Pleasance of the Business Research Institute will address the audience on the topic of Analyzing Client Behavior. Members can register by calling 583-9261 or visiting www.busind.org.","range":[155,157]},{"id":"D2-p158","set":"D2","title":"Reading material – Questions 158–161","body":"Chester Corp. Credit Card\n                                Disputed Item Claim Form\nPlease complete all items on this form and sign it before mailing. Do not include your credit card\npayment. This claim form must be sent in a separate envelope.\n\nName    Helga Larsen\nDate     March 25,20--\nAmount Disputed  $115\nMerchant  Online Office Supplies, Inc.\n\nI have examined my statement and am disputing a charge made to my account for the following reason:\n\n___ This purchase was not made by me or by any other person authorized to use my card.\n_X__ The amount shown on my statement is different from the amount I was charged at the time of\n     purchase. Amount charged at time of purchase was $75 .\n    (Enclose a copy of the sales receipt.)\n___ The item was to be shipped to me by mail. Expected delivery date __________.\n    (This claim cannot be made until 30 days after the expected delivery date.)\n___ The merchandise I purchased was defective and returned by me to the merchant.\n\nReturn date ______________ . (Enclose copy of return receipt or postal receipt.)\n\nSignature : Helga Larsen","range":[158,161]},{"id":"D2-p162","set":"D2","title":"Reading material – Questions 162–163","body":"Ming & Associates\n                                 1800 Pacific Boulevard\n                                        Sydney\nApril 10, 20--\nHarold Ungemach\nBox 86449\nSydney\n\nDear Mr. Ungemach,\n\nThank you for sending us your resume. Your qualifications are impressive. Unfortunately, we are rarely\nin the position of hiring full-time employees. We do, however, frequently have a need for consultants to\nwork on temporary assignments. We are often looking for professionals with your background and skills\nto work on certain projects. If you would be interested in a temporary consulting position, please let me\nknow. I will then keep your resume on file and notify you when a suitable assignment becomes available.\nAgain, thank you for thinking of us. I will look forward to hearing from you.\nSincerely,\nMara Knightly\nHuman Resources Coordinator","range":[162,163]},{"id":"D2-p164","set":"D2","title":"Reading material – Questions 164–167","body":"Central Power Company\n                              Account #4885 9965 0066 43\n                              Notification of Discontinuation of Service\n\nPayment on your electric bill is now more than 30 days overdue. In compliance with National Regulation\n#50504, if we do not receive payment within 10 business days, we will discontinue your service. We must\nreceive payment of $85 due on your bill plus a $15 late fee before August 31 to avoid interruption of\nservice. Once disconnection has occurred, all outstanding charges must be paid in addition to a $50\nreconnection fee before we can resume your service. You may be eligible for a monthly installment plan.\nPlease contact our Customer Service office to discuss financing options.\n\n                   See the reverse side of this notice for a complete explanation\n                    of our rights and obligations under National Regulation #50504","range":[164,167]},{"id":"D2-p168","set":"D2","title":"Reading material – Questions 168–171","body":"Local officials have finally reached an agreement with the Smithson Development Company regarding\nthe construction of a new shopping mall in the Billings Bay neighborhood. A contract was signed last\nnight, and construction is slated to begin in six months. The Smithson Development Company originally\npurchased the land for the mall four years ago from a horse farmer. The road to approval has been a long\none. Plans for the mall have been protested by environmental groups and local residents. However, after\nmodifying plans several times and including many environmentally friendly features as part of the\nconstruction, Smithson was finally able to win the approval of the city council.\n\nThe Billings Bay Mall will be the largest by far in our area. Space is planned for 250 retail shops as well\nas two large department stores, 20 restaurants, cafés, and snack shops, a 10-screen movie theater, an\nindoor play area, classroom space for the local community college, and a small walk-in health clinic.\nThere will also be a 750-car underground parking garage, as well as space for at least twice as many cars\nin outdoor parking areas. Smithson estimates that construction will take no more than one year. Plans for\na grand opening are already under way.","range":[168,171]},{"id":"D2-p172","set":"D2","title":"Reading material – Questions 172–174","body":"SALE!      SALE!\n                       SALE!\n                        Pinkerton's announces its biggest sale of the year.\n           We have slashed prices on select items throughout the store.\n          Printer ink cartridges-Buy one at $30, get the second one at 50% off\n          Photocopier paper-Buy one pack of 500 sheets, get the second one free\n          Jumbo pack notebooks-25% each pack of 10\n          Desk organizers-Assorted colors, 15% off\n          Office desks and computer stands-35% off\n          Super-Comfort brand desk chairs-Assorted colors, 50% off\n\n                            Hurry on down to Pinkerton's.\n                With deals like these, items will fly right off the shelves!\n                               Sale ends Saturday.","range":[172,174]},{"id":"D2-p175","set":"D2","title":"Reading material – Questions 175–178","body":"Eastman Energy Associates\n                                 54 East Putnam Avenue\n                                             Riverside\nJune 8, 20--\n\nPriscilla Pavlis\nPavlis and Company\nP.O. Box 16\nRiverside\n\nDear Ms. Pavlis,\n\nThank you for your letter of May 25. I am very happy to respond to your questions about our services.\nEastman Energy Associates conducts energy audits of businesses with the aim of helping our customers\nheat and cool their buildings more efficiently. Typically, we begin by inspecting furnaces, air-\nconditioning units, and heating and cooling ducts for efficient operation and compatibility with your\nheating and cooling needs. We then conduct a thorough inspection of the building itself, both inside and\noutside, for places where air can enter and escape. We focus on outside doors and windows, outside walls\nand the roof.\n\nWithin a week of our visit, we send a complete written report with an evaluation of your building's\nstrengths and weaknesses. We also include a list of suggested upgrades with their estimated costs as well\nas estimated savings in heating/cooling costs. We follow up with a phone call to ensure that you\nunderstand each detail and to address any concerns you may have. An audit of a building of your size\nwould take about eight hours to complete. We would charge $1,500 for the audit, including the written\nreport and follow-up call. Any further consulting you may require beyond that would be charged at our\nhourly rate of $175 an hour.\n\nPlease let me know if you have any further questions. You can reach me by phone at 492-0983. Call that\nsame number if you would like to schedule an audit for your building. We are currently making\nappointments for next month. Thank you for contacting Eastman.\n\nSincerely,\n\nKarla Heinz\nEnergy Consultant","range":[175,178]},{"id":"D2-p179","set":"D2","title":"Reading material – Questions 179–180","body":"HELP WANTED                                 179. Who should apply for this job?\n                                                  (A) A dentistWe are seeking an experience financial\n                                                     (B) An accountantprofessional to manage the accounting office at a\n                                                     (C) A software engineerrapidly growing financial services company.\n                                                  (D) A health care managerResponsibilities of the position include\ncoordinating the work of a six-person accounting\ndepartment, managing business accounts, and\nreviewing client financial information. This\nposition reports to the chief financial officer (CFO)\nRequirements: university degree in accounting, a\nminimum of three years’ management experience,","range":[179,180]},{"id":"D2-p181","set":"D2","title":"Reading material – Questions 181–185","body":"CRISP COMPANY\n\nNew charges for: Byron & Farrar Law Offices, account #2095687\nFrom 03/01 to 03/31 20—\n\nPrevious\nBalance from last bill: ………………………………….. $125\nPayments received: ……………………………………….. $0\nPrevious balance due: ……………………………………$125\n\nCurrent\nLocal phone service: ………………………………………$50\nLong distance phone charges: …………………………….$39\nInternet services: …………………………………………..$35\nTax:………………………………………………………….$8\nCurrent charges: ………………………………………….$132\n\nTotal due: Please pay this amount: $257\n\nPayments received after March 25 are not applied to this statement. To dispute a charge, contact our\ncustomer service office in writing:\n                                     Crisp Company\n                              Customer Service Office\n                                45 Mountain View Road\n                                     Wilmington\nApril 18, 20--\n\nCrisp Company\nCustomer Service Office\n45 Mountain View Road\nWilmington\n\nDear Customer Service,\n\nI am writing in regard to the recent bill from your company sent to us at Byron and Farrar Law Offices,\naccount #2095687. In this bill we were charged for two months of service. This is incorrect since we owe\nonly for this month's service. I personally paid last month's bill. According to my records, I wrote a check\nto your company for $125 and mailed it on March 26. I have contracted my bank and have been informed\nthat that check has been processed and your company has received the funds. They will be providing me\nwith a copy of the check before the end of the week, which I will then forward to you. Tomorrow I will be\nsending you a check for the amount owed for this month's charges only. Please correct you records to\nshow the payment already made on last month's bill. Thank you for your attention. I expect the next bill\nwill show the correct charges.\n\nSincerely,\nRobert Krumholz\nOffice Manager","range":[181,185]},{"id":"D2-p186","set":"D2","title":"Reading material – Questions 186–190","body":"WORKSHOP SCHEDULE - DRAFT\nTime      Location       Presentation                                 Presenter\n9:30     Room B       Changing World Markets                        L. Chang\n11:00    Room C         Cross-Cultural Considerations in Marketing          J. H. Lee\n12:15    Room C       Lunch\n1:30     Room D        Analyzing Demographics                                     I. A. Kim\n3:00     Room A         Internet Marketing                           D. Wang\n4:00     Room A       Open Discussion                                All\n\n\nTo: F. Bao\nFrom : J.S. Park\nSubject: Workshop logistics\nDate: Monday, June 10\nattch: Workshop schedule\n\nMs. Bao,\nI have attached a draft of the scheduled for the upcoming workshop. I wish we had scheduled it for a\nweek from today instead of for the day after tomorrow. There is still so much to do to get ready; however,\nwe can't change the date now. I really appreciate your support in getting things ready.\n\nHere are some things I need you to take care of. Tea and snacks should be served immediately after Mr.\nChang’s presentation. He plans to talk for just an hour, so there will be time for this before the next\npresentation begins. Also, the room that we have scheduled for lunch is one of the smaller rooms, and\nserving a meal there would be difficult. In addition, we have a workshop scheduled in the same place\nright before lunch, so there would be no time to set up. See if you can exchange places with the\nDemographics workshop. The room we have scheduled for that seems convenient and comfortable for\neating.\n\n\nPlease make sure there are enough chairs in each room for everyone. So far, 45 people have registered for\nthe workshop, but a few more registrations could come in today or tomorrow. You should have 15 extra\nchairs in each room just to be safe. There is one last scheduled change. Mr. Wang will have to leave right\nafter lunch, so please give him Ms. Lee's time slot, and she can take Mr. Wang's afternoon time slot. Send\nme the revised schedule this afternoon. Thank you.\n\nJae Sun Park","range":[186,190]},{"id":"D2-p191","set":"D2","title":"Reading material – Questions 191–195","body":"Annual Leave\nAll employees of the Goodland Corporation are entitled to annual leave, or vacation days, according to\ntheir length of service at Goodland, as follows:\n          Years Employed at Goodland                  Number of Annual Leave Days\n                      0-2                                         10\n                      3-5                                         15\n                     6-10                                         20\n                11 or more                                      25\n\nAnnual leave days must be used up by the end of the calendar year or they will be forfeited. The actual\ndates when leave days may be taken are dependent on permission from the employee's supervisor. To\napply to use annual leave days, the employee must complete from number 465, obtain the supervisor's\npermission and signature, and submit the form to the human resource director no later than 21 calendar\ndays before the date when the requested leave will begin. Incomplete or late requests will not be reviewed\nand leave will not be granted.\n\n                                                              Form No. 465\n                         The Howland Corporation\n                            Annual Leave Request Form\nName: Daniel Ortiz\nDepartment: Research and Development\nNumber of annual leave days allowed: 15\nNumber of leave days requested: 5\nDates: July 21 – July 25   Name of Supervisor: Nestor Perez\nAuthorizing signature:_______________________________________\n\n                      Please submit this form to Daisy Ortega, Room 14.","range":[191,195]},{"id":"D2-p196","set":"D2","title":"Reading material – Questions 196–200","body":"To: Marilyn Sawyer\n                                           From: Paul Lebowski\n                                                   Subject: Office rental\n                                                   Sent: Tuesday, October 3\n\n                                                Marilyn,         FOR RENT\n                                                  Here's a link to an office rental ad I found online:\nLarge,   sunny   office   in   convenient       www.offices.com/10-01. I think it's worth looking at\ndowntown location, near two bus  routes,       even though the rent is a bit high. I know it is a good\nample parking in rear. 900 sq. feet divided       deal more than we are paying now, but look at the\ninto two  private  offices and comfortable         size. It's twice as big as our current office, and I'm\nreception area, small kitchen, one bathroom.       sure we can use the space. And it has a kitchen and\nModern   10-story   building   with  two      bathroom and a reception area just like we have now.\nelevators. $1,750/month. First month's rent       Unfortunately it is nowhere near a subway station.\nand security deposit equal to one month's       That is a convenience I would miss having, but it\nrent required to move in. To see, call City       does have parking, unlike our current office. I'm sure\nOffice Rentals at 382-0838 between 8:30       our clients would appreciate that. It would also be\nand 4:30, Tues.-Sat.                          good to be in a building with an elevator. I'm really\n                                                         tired of using the stairs. I'd like to see the space as\n                                            soon as possible. Could you call and make an\n                                              appointment? Try and get one for tomorrow if you\n                                                   can, because after that I'll be away until next\n                                         Monday, as you know. Thanks.\n                                               Paul","range":[196,200]},{"id":"D3-p141","set":"D3","title":"Reading material – Questions 141–143","body":"February 22, 20__\n\nDear Samuel,\n\nI have good news for you. I have taken a new job in Sydney. My family and I will move [141] next month. Since you have lived in Sydney for so long, I would like to ask for your advice.\n\nWe would like to rent a small house in a nice [142] neighborhood. My children are small, so we would like to be in a quiet place away from businesses and traffic. We would like to live close to good schools, and I also want to be near public transportation so that I can get to work easily. Can you recommend some good neighborhoods to me?\n\nI plan to visit your city in two weeks [143] for a house. Please send me your recommendations before then if you can. I hope we can get together while I am in town.\n\nYour friend, Boris","range":[141,143]},{"id":"D3-p144","set":"D3","title":"Reading material – Questions 144–146","body":"Welcome to the Sleepwell Motel. We hope [144] stay is a pleasant one. If you need assistance, please [145] 09 to speak to someone at the front desk.\n\nPlease take note of the following local services:\nTaxi: 985-555-9965\nCity buses: 985-555-0924\nAirport: 985-555-9321\nDeluxe Movie Theater: 985-555-9651\nRestaurant Guide: 985-555-8723\nBlack Cat Night Club: 985-555-7342\nPolice: 985-555-9111\nFire: 985-555-2233\n\nA [146] breakfast is available to all motel guests in the lobby from 6:00 A.M. to 9:00 A.M.","range":[144,146]},{"id":"D3-p147","set":"D3","title":"Reading material – Questions 147–149","body":"Questions 147-149 refer to the following letter.\n\nOffice Works\n\n544 Hudson Street\nBoston, MA 03291\n\nMarch 29, 20__\n\nMary Braddock\n\nBanquet Director\n\nGarden Hotel\n\n219 Center Circle\n\nBoston, MA 03299\n\nDear Ms. Braddock:\n\nOffice Works is seeking a place to host our first awards banquet.\n\nThe evening will include dinner, speeches and an awards presentation. The\nexact date is flexible, but we would like to hold it on a Friday or Saturday\nevening in June.\n\nWe expect approximately 200 guests. We would like a room with a good sound\nsystem so that the guests will be able to hear the speeches __________.\n","range":[147,149]},{"id":"D3-p150","set":"D3","title":"Reading material – Questions 150–152","body":"Ready to buy a NEW CAR? LOOK NO FURTHER\n\nCango Cars is holding the biggest sale in its history of selling cars. For over ten years, Cango has been the leading [150] of new and used cars in the Canmore area. That's because Cango has the best reputation for selling reliable, affordable vehicles in all of Alberta. We at Cango care about the drivers and passengers of Canmore. We pride [151] in doing all we can to prevent dangerous cars from getting back onto our roads and making sure our customers feel secure with the cars they choose. There is nothing more important to us than [152].\n\nCome to Cango Cars between August 5th and 10th, and enter to win a gently used 5-seat family sedan. All our vehicles, both new and used, come with a one-year warranty.","range":[150,152]},{"id":"D3-p153","set":"D3","title":"Reading material – Questions 153–155","body":"PART 7\n\nDirections: In this part, you will read a selection of texts, such as magazine and newspaper\naréicles, letters, and advertisements. Each text is followed by several questions. Select the best\nanswer for each question and mark the letter (A), (B), (C), or (D) on your answer sheet.\n\nQuestions 153-155 refer to the following newspaper report.\n\nTomorrow, bus service on Orchard Road will be changed between\nthe hours of 9 A.M. and 12:30 p.M. The Chingay Parade will take\nplace from 10:00 A.M. to 12:00 P.M.\n\nNumber 7, 13, 14, 16, and 23 buses will turn left onto Scotts\nRoad, right onto Clemenceau Avenue, and left onto Orchard Road\nbelow the parade route.\n\nIn the event of rain, the diversion will take place at 3:00 P.M.\nand the parade shortly after.\n","range":[153,155]},{"id":"D3-p156","set":"D3","title":"Reading material – Questions 156–159","body":"Questions 156-159 refer to the following memo.\n\nTo: * All employees\nFrom: R. Wettimuny\nRe: Ordering Supplies\n\nThere has been a great deal of confusion regarding the\ncorrect procedures for ordering office supplies. Therefore,\nI will explain the proper steps to follow here. First, all\nrequests for supplies must be typed and signed. Only typed\nrequests will be accepted because I am tired of trying to\ndecipher illegible handwriting. Second, all requests must\nbe on my desk by the fifteenth of every month. I make out\n\nthe order once each month and do not want to have to\nmake addendums or extra orders. From now on, late\nrequests will be put on hold until the following month.\nRequests that are received on time and approved by me\nwill be sent on to the Accounting Department for processing.\n\nPlease be aware that it takes from two to six weeks for\nsupplies to arrive once the order has been made, so it\n\nis important to plan ahead and make your requests\naccordingly.\n\nYour cooperation is appreciated.\n","range":[156,159]},{"id":"D3-p160","set":"D3","title":"Reading material – Questions 160–162","body":"Questions 160-162 refer to the following chart.\n\nAsia, Marshall Is., North America, Central Africa,\nGuam, Midway, America, Oceania, South America\n| and others Middle East, Europe\n\nUp to25g |90yen\nUpto50g | 160 yen\n\nPostcard Uniform rate of 70 yen to anywhere in the world\nUniform rate of 90 yen to anywhere in the world\n\n“Standard-sized item: 14—23.5 cm length, 9-12 cm width, thickness of within 1 cm\n","range":[160,162]},{"id":"D3-p163","set":"D3","title":"Reading material – Questions 163–166","body":"Questions 163-166 refer to the following bulletin.\n\nJ\n\nRESERVATIONS: Keservations are required for all first-class compartments.\nsecond- and third-class coaches do not require reservations.\n\nDINING: Trains that do not have first-class cars will not have a dining car.\n\nSandwich and beverage carts will be on all trains.\n\nBAGGAGE: Passengers may carry up to four pieces of luggage on the\ntrain. Additional baggage may be checked.\n","range":[163,166]},{"id":"D3-p167","set":"D3","title":"Reading material – Questions 167–171","body":"Questions 167-171 refer to the following letter.\n\n. Lovely Lady Fashions\n32 Elizabeth Bay Road\nSydney, Australia\nDecember 15, 20 __\n\nMrs. R.S.W. Mangala\nJewelry Export Ltd.\n\n40 Galle Face Road\n\nColombo 1, Sri Lanka\n\nDear Mrs. Mangala:\n\nI am interested in information regarding your company’s new line of jewelry. I have seen\nthe samples on your website, and I am interested in the possibility of importing your\njewelry into Australia. I think it would sell very well here, especially among the younger\nwomen who make up the majority of my company’s clientele.\n\nI will be making a trip to Malaysia, India, and Sri Lanka next summer. I would like to\narrange to meet with you then to discuss setting up a business relationship. Please let me\nknow when you will be available for a meeting. In the meantime, I would appreciate your\nsending a list of your wholesale prices and information about ordering and shipping.\n\nMy associates in London have been very pleased with the quality of the gems you have\nsent them, and they have had a great deal of success with them. I look forward to doing\nbusiness with you in the near future.\n\nSincerely,\n\nJeamase Goran |\n\nJames Goodwin\nImport Manager\n","range":[167,171]},{"id":"D3-p172","set":"D3","title":"Reading material – Questions 172–174","body":"Questions 172-174 refer to the following label.\n\n“&\n\nTO WATERPROOF SHOES AND BOOTS:\n\nBefore applying, remove all dust, mud, and dirt from shoes. Make\nsure shoes are completely dry. Hold spray can 6-8 inches from\nclean, dry shoes. Let product saturate leather, covering all surfaces\nevenly. Allow to dry for one hour. Repeat application one more\ntime. Allow to dry before use. The protection will last for six\nmonths under average climatic conditions. This product can also\nbe used to protect leather handbags and briefcases. Do not use on\n\nsuede. May cause discoloration of some leather products. Test on\na small area first.\n\nCaution\n\n¢ Can cause damage to the respiratory system. Use in a\nwell-ventilated area only, away from children and pets.\n\n¢ Highly flammable. Use away from stoves, ovens, radiators,\nportable heaters, open flames, and other heat sources.\n\nOR OE MAT Se Ca oe ee\n","range":[172,174]},{"id":"D3-p175","set":"D3","title":"Reading material – Questions 175–177","body":"SURVEY OF ELEMENTARY SCHOOL TEACHERS — Reasons for lack of computer education programs in public schools\n\nWhile computer skills are becoming more and more necessary in everyday life, not enough children are receiving proper computer education in schools. Researchers surveyed 43 elementary school teachers. Some teachers reported more than one reason.\n\nReason | Respondents | Percent\nNot enough computers in school | 14 | 32.6%\nTeachers fear computers | 8 | 18.8%\nNot enough time in curriculum | 14 | 32.6%\nToo expensive | 20 | 46.5%\nPoor-quality software | 16 | 37.2%\nTotal respondents: 43","range":[175,177]},{"id":"D3-p178","set":"D3","title":"Reading material – Questions 178–180","body":"Questions 178-180 refer to the following report.\n\n“£\n\nThe Hotel Manager of the Year Award Essay\nCompetition winner was announced last\nnight by the County Association of Hotel\nManagers. The winning essay was written by\nMr. Randolph Ng of the Henry Street Historic\nHotel. Mr. Ng wins a prize of $2,500 for his\nessay titled “The Hotel Family.” “| believe that\na hotel manager must be like a parent to\nhis or her staff,” said Mr. Ng at the awards\nceremony banquet last night. “A good man-\nager concentrates on helping others to be\nsuccessful.” The second and third prize win-\nners were Gina Becke of the Woodside\nGardens Hotel and Yoko Lee of the Hotel at\nRiverton, respectively. The annual essay\ncompetition was started by the County\nAssociation of Hotel Managers six years ago\nas a means of recognizing the hard work of\nhotel managers and encouraging them to\nreflect on what they do and share it with\ntheir colleagues. “It has become a very\npopular contest,” says Jim Wilkerson,\npresident of the association. “We get\nhundreds of entries every year.” Following\nthe awards presentation at last night's\nceremony, Mr. Wilkerson announced that he\nwill be retiring from his position as\nassociation president next year. A\nreplacement has not yet been announced.\n\n288 PRACTICE TEST ONE\n","range":[178,180]},{"id":"D3-p181","set":"D3","title":"Reading material – Questions 181–185","body":"The National Theater presents a live performance of Romeo and Juliet, the third in our Festival of Shakespeare series.\nDates: March 12–29. Thursday, Friday and Saturday evenings, Saturday and Sunday matinees.\nTicket prices: Matinee orchestra $45, balcony $35. Evening orchestra $75, balcony $55.\nSpecial group discounts: Groups of 15 or more receive 10% off the regular price; groups of 25 or more receive 20% off. Call the box office for details. The National Theater is downtown, within walking distance of the Center City subway station.\n\nE-MAIL\nTo: Maya Berg\nFrom: Morris Stein\nSubject: Shakespeare tickets\n\nMaya, I'd like to get tickets for our entire department to see Romeo and Juliet. If everything goes, there will be just enough people for a 10% discount on the ticket prices. Call the box office to find out how to order the group discount tickets, and see if you can get tickets for opening night. Make sure they are orchestra seats. I think this will be an enjoyable and convenient outing for everyone. We can all take the subway to the theater together after work. Thanks, Morris.","range":[181,185]},{"id":"D3-p186","set":"D3","title":"Reading material – Questions 186–190","body":"Questions 186-190 refer to the following two letters.\n\nCustomer Service Office\nUnion Bank\n\n135 Main Street\n\nHome, AK 99999\n\nDear Customer Service:\n\nI received a debit card from your bank last week, and I have some questions regarding\nits use. Specifically, Iam concerned about liability. If a thief steals my card and makes\ncharges to my account, am I responsible for paying for them, or do I have protection\nlike I have with my credit card? I looked in the booklet Rules for Personal Accounts at\nUnion Bank, but I didn’t see the information there.\n\nI have been a customer at your bank for over 15 years and have always been happy\nwith the service I have received there. I hope you can answer my question satisfactorily.\n\nSincerely,\n\nArthur Schmidt\nArthur Schmidt\n\nMr. Arthur Schmidt\n1705 Oak Boulevard\nHome, AK 99999\n\nDear Mr. Schmidt:\n\nYou recently sent a letter to our office asking about the Union Bank debit card.\nYou wanted to know about liability. Our policy is the following: If you report a\nlost or stolen card within 48 hours, you are not responsible for any charges\nmade on it. If you report it after 48 hours, you will be responsible for charges\nup to $50. So you see, the debit card has similar protection to a credit card.\nThe information is actually in the document you mentioned. It appears on page\n39. I am enclosing a photocopy of it for your convenience. Please let me know if\nI can be of any further assistance to you.\n\nsincerely,\n\nElena Ugarte\n\nElena Ugarte\n\n292 PRACTICE TEST ONE\n","range":[186,190]},{"id":"D3-p191","set":"D3","title":"Reading material – Questions 191–195","body":"E-MAIL 1\nTo: M. Takubo\nFrom: J. H. Choi\nSubject: Office rental\n\nMr. Takubo, As we discussed on the phone, I am interested in renting an office for my accounting firm. We are a small business, so the space doesn't need to be large, but a convenient location is important. We need to be downtown and close to subway and bus lines. I hope you can find something reasonably priced for us in that area. We hope to spend no more than $2,000 a month. We have to leave our current office soon, so we need something that will be available by the end of the month.\n\nE-MAIL 2\nTo: J. H. Choi\nFrom: M. Takubo\nSubject: Downtown office\n\nMs. Choi, I have an office to show you that I think you'll like. It is right downtown on State Street. Since it is on the small side, the rent is somewhat lower than other offices in the area, although it's $500 more than the price you mentioned. I don't think you'll find a better price in such a convenient location. The building is very clean, and the landlord keeps it well maintained. The office will be available by the time you need it. I would like to show it to you soon. Will tomorrow morning suit you? I can meet you at the office at 11:00. The address is 730 State Street, Suite 900. Please let me know if this works for you.","range":[191,195]},{"id":"D3-p196","set":"D3","title":"Reading material – Questions 196–200","body":"JOB ADVERTISEMENT\nLocal cable television provider has an opening in its accounting department for a customer account representative. Responsibilities include answering customer telephone inquiries about billing and resolving billing disputes. Must have at least two years' experience in customer service. Experience with accounting, billing, or collections desirable. Proficiency with word processing and spreadsheet software required. College degree in accounting or related field desirable. The right candidate will also have excellent communication and organization skills. Send résumé and cover letter to Ms. Ahmad, Human Resources Director, Universal Cable Company, 1123 25th Street, Putnam, OH 44408.\n\nLETTER\nJune 25, 20__\nMs. Ahmad, Human Resources Director, Universal Cable Company\n\nDear Ms. Ahmad:\nI am interested in applying for the position you advertised in the Sunday edition of the Local Times. I have all the qualifications for the job, and more. I have worked for several years as a customer service representative for a mail order company—in fact, for three more years than you require. Prior to that, I worked for four years in the billing department of a local magazine. Though my college degree is in French, I took two semesters of accounting classes. I also have experience using the computer software you mentioned.\n\nI hope you will consider me as a candidate for the position. I look forward to hearing from you.\nSincerely, Joe Butler.","range":[196,200]}],"photos":{"D1-1":"data:image/webp;base64,","D1-2":"data:image/webp;base64,","D1-3":"data:image/webp;base64,","D1-4":"data:image/webp;base64,","D1-5":"data:image/webp;base64,","D1-6":"data:image/webp;base64,","D1-7":"data:image/webp;base64,","D1-8":"data:image/webp;base64,","D1-9":"data:image/webp;base64,","D1-10":"data:image/webp;base64,","D3-1":"data:image/webp;base64,","D3-2":"data:image/webp;base64,","D3-3":"data:image/webp;base64,","D3-4":"data:image/webp;base64,","D3-5":"data:image/webp;base64,","D3-6":"data:image/webp;base64,","D3-7":"data:image/webp;base64,","D3-8":"data:image/webp;base64,","D3-9":"data:image/webp;base64,","D3-10":"data:image/webp;base64,","D2-1":"data:image/webp;base64,","D2-2":"data:image/webp;base64,","D2-3":"data:image/webp;base64,","D2-4":"data:image/webp;base64,","D2-5":"data:image/webp;base64,","D2-6":"data:image/webp;base64,","D2-7":"data:image/webp;base64,","D2-8":"data:image/webp;base64,","D2-9":"data:image/webp;base64,","D2-10":"data:image/webp;base64,"},"tracks":{"D1":{"1":"01 Track 1.mp3","2":"02 Track 2.mp3","3":"03 Track 3.mp3","4":"04 Track 4.mp3","5":"05 Track 5.mp3","6":"06 Track 6.mp3","7":"07 Track 7.mp3","8":"08 Track 8.mp3","9":"09 Track 9.mp3","10":"10 Track 10.mp3","11":"11 Track 11.mp3","12":"12 Track 12.mp3","13":"13 Track 13.mp3","14":"14 Track 14.mp3","15":"15 Track 15.mp3","16":"16 Track 16.mp3","17":"17 Track 17.mp3","18":"18 Track 18.mp3","19":"19 Track 19.mp3","20":"20 Track 20.mp3","21":"21 Track 21.mp3","22":"22 Track 22.mp3","23":"23 Track 23.mp3","24":"24 Track 24.mp3","25":"25 Track 25.mp3","26":"26 Track 26.mp3","27":"27 Track 27.mp3"},"D2":{"1":"01 Track 1(1).mp3","2":"02 Track 2(1).mp3","3":"03 Track 3(1).mp3","4":"04 Track 4(1).mp3","5":"05 Track 5(1).mp3","6":"06 Track 6(1).mp3","7":"07 Track 7(1).mp3","8":"08 Track 8(1).mp3","9":"09 Track 9(1).mp3","10":"10 Track 10(1).mp3","11":"11 Track 11(1).mp3","12":"12 Track 12(1).mp3","13":"13 Track 13(1).mp3","14":"14 Track 14(1).mp3","15":"15 Track 15(1).mp3","16":"16 Track 16(1).mp3","17":"17 Track 17(1).mp3","18":"18 Track 18(1).mp3","19":"19 Track 19(1).mp3","20":"20 Track 20(1).mp3","21":"21 Track 21(1).mp3","22":"22 Track 22(1).mp3","23":"23 Track 23(1).mp3","24":"24 Track 24(1).mp3","25":"25 Track 25(1).mp3","26":"26 Track 26(1).mp3","27":"27 Track 27(1).mp3"},"D3":{"1":"01 Track 1(2).mp3","2":"02 Track 2(2).mp3","3":"03 Track 3(2).mp3","4":"04 Track 4(2).mp3","19":"19 Track 19(1).mp3","5":"05 Track 5(1).mp3","6":"06 Track 6(1).mp3","7":"07 Track 7(1).mp3","8":"08 Track 8(1).mp3","9":"09 Track 9(1).mp3","10":"10 Track 10(1).mp3","11":"11 Track 11(1).mp3","12":"12 Track 12(1).mp3","13":"13 Track 13(1).mp3","14":"14 Track 14(1).mp3","15":"15 Track 15(1).mp3","16":"16 Track 16(1).mp3","17":"17 Track 17(1).mp3","18":"18 Track 18(1).mp3","20":"20 Track 20(1).mp3","21":"21 Track 21(1).mp3","22":"22 Track 22(1).mp3","23":"23 Track 23(1).mp3","24":"24 Track 24(1).mp3","25":"25 Track 25(1).mp3","26":"26 Track 26(1).mp3","27":"27 Track 27(1).mp3"}}};</script><script>
const TESTS=[{name:'Test 1',sub:'Photographs',a:1,b:10},{name:'Test 2',sub:'Q&A',a:11,b:40},{name:'Test 3',sub:'Conversations & Talks',a:41,b:100},{name:'Test 4',sub:'Incomplete Sentences',a:101,b:140},{name:'Test 5',sub:'Reading Passages',a:141,b:200}];
const Q={}; for(const x of DB.questions)Q[x.id]=x;const P={};for(const x of DB.passages)P[x.id]=x;
const $=id=>document.getElementById(id), esc=s=>String(s??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;');
const STORE='toeic_master_three_sets_v3';let state;try{state=JSON.parse(localStorage.getItem(STORE))||{}}catch{state={}};
state.answers=state.answers||{};state.shuffleOptions=state.shuffleOptions||{};state.orders=state.orders||{};state.shown=state.shown||{};state.test=Number.isInteger(state.test)?state.test:0;state.source=state.source||'all';state.filter=state.filter||'all';state.page=0;state.graded=false;
let externalAudio={},loadedAudioId='';const save=()=>{try{localStorage.setItem(STORE,JSON.stringify({...state,graded:false,page:0}))}catch{}};
function toast(s){const t=$('toast');t.textContent=s;t.style.display='block';clearTimeout(toast._t);toast._t=setTimeout(()=>t.style.display='none',3500)}
function shuffle(a){let b=[...a];for(let i=b.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function pool(){const t=TESTS[state.test];return DB.questions.filter(q=>q.n>=t.a&&q.n<=t.b&&(state.source==='all'||q.set===state.source))}
function orderKey(){return state.test+'_'+state.source}
function ordered(){let arr=pool(),ids=arr.map(x=>x.id),stored=state.orders[orderKey()];if(stored&&stored.length===ids.length&&new Set(stored).size===ids.length&&stored.every(id=>ids.includes(id)))return stored.map(id=>Q[id]);return arr}
function sortedShown(){const arr=ordered();if(state.filter==='unanswered')return arr.filter(q=>state.answers[q.id]===undefined);if(state.filter==='wrong')return arr.filter(q=>q.answer&&state.answers[q.id]!==undefined&&state.answers[q.id]!==q.answer.charCodeAt(0)-65);if(state.filter==='pending')return arr.filter(q=>!q.answer||q.confidence==='partial');return arr}
function perm(q){const s=state.shuffleOptions[q.id];return s&&s.length===q.options.length?s:q.options.map((_,i)=>i)}
function stat(){let arr=pool();let done=arr.filter(x=>state.answers[x.id]!==undefined).length;let valid=arr.filter(x=>!!x.answer);let marked=valid.filter(x=>state.answers[x.id]!==undefined);let good=marked.filter(x=>state.answers[x.id]===x.answer.charCodeAt(0)-65).length;return {total:arr.length,done,graded:valid.length,marked:marked.length,good,unverified:arr.length-valid.length}}
function updateStats(){let s=stat();$('stats').innerHTML=`<span><b>${s.done}</b> / ${s.total} đã chọn</span><span><b>${s.graded}</b> câu có đáp án kiểm tra</span><span><b>${s.unverified}</b> câu đang xác minh</span>`;$('bar').style.width=(s.total?s.done/s.total*100:0)+'%';if(state.graded){$('score').classList.add('show');$('score').innerHTML=`<div class="resultStrong">${s.good}/${s.marked}</div><b>Trả lời đúng trên số câu đã làm và có đáp án.</b> Còn ${s.graded-s.marked} câu đã có đáp án nhưng bạn chưa chọn. ${s.unverified} câu không được tính vào điểm. <div style="margin-top:7px">${s.marked?Math.round(s.good/s.marked*100):0}% chính xác trên số đã chấm.</div>`}else{$('score').classList.remove('show')}}
function toggleTest(i){state.test=i;state.page=0;state.graded=false;state.filter='all';save();render()}
function topRender(){$('tabs').innerHTML=TESTS.map((t,i)=>`<button class="tab ${i===state.test?'active':''}" data-test="${i}"><strong>${t.name}</strong><span>${t.sub} · ${(t.b-t.a+1)*3} câu</span></button>`).join('');$('tabs').querySelectorAll('[data-test]').forEach(b=>b.onclick=()=>toggleTest(+b.dataset.test));const t=TESTS[state.test];$('currentTitle').textContent=`${t.name} · ${t.sub}`;$('setFilter').value=state.source;$('displayMode').value=state.filter;$('audioPanel').style.display=t.b<=100?'block':'none'}
function audTrack(q){if(q.n>100)return null;if(q.set==='D2')return String(q.n<=10?1:q.n<=40?2:q.n<=70?3:4);return String(q.n<=10?2:q.n<=40?4:q.n<=70?6+Math.floor((q.n-41)/3):17+Math.floor((q.n-71)/3))}
function audioPath(q){const tr=audTrack(q),file=tr&&DB.tracks[q.set]?.[tr];return file?`audio/${q.set}/${encodeURIComponent(file)}`:null}
function playAudio(q){const tr=audTrack(q),file=tr&&DB.tracks[q.set]?.[tr];if(!file){toast('Chưa có tệp audio phù hợp.');return}const media=$('mainAudio');const key=q.set+'/'+file;const src=externalAudio[key]||audioPath(q);if(key!==loadedAudioId){media.src=src;loadedAudioId=key;media.load()}$('audioName').textContent=q.set+' · '+file;media.play().catch(()=>toast('Cần tải gói ZIP kèm audio để phát trực tiếp.'));
 $('audioText').textContent=`Track ${tr} — nguồn ${q.set}`}
function passageHtml(q){let p=q.passage&&P[q.passage];if(!p||!p.body?.trim())return '';const open=q.n>100?'open':'';let t=p.table;let table=t?`<table style="border-collapse:collapse;font-size:12px"><thead><tr>${t.headers.map(c=>`<th style="border:1px solid #cad6e9;padding:5px">${esc(c)}</th>`).join('')}</tr></thead><tbody>${t.rows.map(r=>`<tr>${r.map(c=>`<td style="border:1px solid #cad6e9;padding:5px">${esc(c)}</td>`).join('')}</tr>`).join('')}</tbody></table>`:'';return `<details ${open} class="passage"><summary>📖 ${esc(p.title||'Đọc đoạn văn / dữ liệu')} (nhấn để thu gọn)</summary><div class="reading">${esc(p.body)}</div>${table}</details>`}
function card(q,pos){const options=perm(q),chosen=state.answers[q.id];let correct=typeof q.answer==='string'?q.answer.charCodeAt(0)-65:null;let visible=state.graded||state.shown[q.id];let feedback=visible&&correct!==null;let answers=options.map((originalIndex,idx)=>{const t=q.options[originalIndex];const selected=chosen===originalIndex;const cls=[selected?'selected':'',feedback&&originalIndex===correct?'correct':'',feedback&&selected&&originalIndex!==correct?'incorrect':''].join(' ');return `<label class="opt ${cls}"><input type="radio" name="select-${q.id}" value="${originalIndex}" ${selected?'checked':''} data-choice="${esc(q.id)}"/><span class="letter">${'ABCD'[idx]}.</span><span class="opt-text">${esc(t)}</span></label>`}).join('');let photo=q.n<=10?DB.photos[q.set+'-'+q.n]:null;let note=!q.answer?`<div class="answer-box pending">⚠️ Chưa xác minh đáp án. Lựa chọn của bạn vẫn được lưu, nhưng không tính điểm.</div>`:!visible?'':`<div class="answer-box"><strong>✓ ${esc(q.options[correct])}</strong><br><span class="small-note">Đáp án gốc: ${q.answer} · Vị trí sau xào: ${'ABCD'[options.indexOf(correct)]}</span>${q.n>=101?`<p style="margin:6px 0 0">${esc(q.explanation||'Đối chiếu lại cấu trúc và ngữ cảnh để hiểu phương án được chọn.')}</p>`:''}</div>`;
 return `<article class="question" id="card-${q.id}"><div class="qhead"><span class="qnum">Câu ${q.n}</span><span class="meta">${q.set} · Part ${q.part}</span>${(q.confidence==='partial'||!q.answer)?'<span class="meta pending">Chưa xác minh đầy đủ</span>':''}<span class="small-note" style="margin-left:auto">${pos+1}/${ordered().length}</span></div>${photo?`<img class="photo" loading="lazy" alt="Photograph for question ${q.n}" src="${photo}">`:''}${passageHtml(q)}<div class="qtitle">${esc(q.q)}</div>${q.n<=100?`<p><button class="btn small" data-listen="${q.id}">▶ Nghe audio câu này</button></p>`:''}${options.length?`<div class="options">${answers}</div>`:'<div class="notice">Các phương án của câu này cần đối chiếu lại bản scan/audio.</div>'}<div style="margin-top:10px"><button class="btn small" data-show="${q.id}">${state.shown[q.id]?'Ẩn lời giải':'Xem lời giải câu này'}</button></div>${note}</article>`}
function navRender(shown){const n=$('navigator');const arr=ordered();n.innerHTML=arr.map((q,i)=>`<button class="navnum ${state.answers[q.id]!==undefined?'answered':''} ${Math.floor(i/12)===state.page?'current':''}" data-jump="${q.id}" title="${esc(q.set)} - Câu ${q.n}">${q.set.slice(-1)}·${q.n}</button>`).join('');n.querySelectorAll('[data-jump]').forEach(b=>b.onclick=()=>{state.filter='all';$('displayMode').value='all';let pos=ordered().findIndex(q=>q.id===b.dataset.jump);state.page=Math.floor(pos/12);render();setTimeout(()=>document.getElementById('card-'+b.dataset.jump)?.scrollIntoView({behavior:'smooth',block:'center'}),10)})}
function render(){topRender();const list=sortedShown(),per=12,totalPages=Math.max(1,Math.ceil(list.length/per));state.page=Math.max(0,Math.min(state.page,totalPages-1));let start=state.page*per;const arr=list.slice(start,start+per);$('questions').innerHTML=arr.length?arr.map((q,i)=>card(q,start+i)).join(''):'<div class="panel">Không có câu nào phù hợp bộ lọc.</div>';
 $('pageInfo').textContent=`Trang ${state.page+1}/${totalPages} · ${list.length} câu đang hiển thị`;$('prev').disabled=state.page===0;$('next').disabled=state.page>=totalPages-1;
 $('questions').querySelectorAll('[data-choice]').forEach(el=>el.onchange=()=>{state.answers[el.dataset.choice]=Number(el.value);save();updateStats();el.closest('.question').querySelectorAll('.opt').forEach(op=>op.classList.toggle('selected',op.contains(el)))});
 $('questions').querySelectorAll('[data-show]').forEach(b=>b.onclick=()=>{state.shown[b.dataset.show]=!state.shown[b.dataset.show];save();render()});
 $('questions').querySelectorAll('[data-listen]').forEach(b=>b.onclick=()=>playAudio(Q[b.dataset.listen]));navRender(list);updateStats();$('reveal').textContent=pool().every(q=>state.shown[q.id])?'🙈 Ẩn đáp án':'👁 Xem đáp án'}
$('setFilter').onchange=e=>{state.source=e.target.value;state.page=0;state.graded=false;save();render()};$('displayMode').onchange=e=>{state.filter=e.target.value;state.page=0;render()};$('prev').onclick=()=>{state.page--;render();window.scrollTo({top:300,behavior:'smooth'})};$('next').onclick=()=>{state.page++;render();window.scrollTo({top:300,behavior:'smooth'})};
$('shuffleQ').onclick=()=>{const current=ordered();const gmap=new Map();for(let q of current){let key=q.set+'|'+q.group;if(!gmap.has(key))gmap.set(key,[]);gmap.get(key).push(q.id)}const groups=shuffle([...gmap.values()]);state.orders[orderKey()]=groups.flat();state.page=0;save();render();toast('Đã xào thứ tự các câu/nhóm. Không đổi đáp án đã chọn.')};
$('shuffleA').onclick=()=>{for(let q of pool())if(q.options.length)state.shuffleOptions[q.id]=shuffle(q.options.map((_,i)=>i));save();render();toast('Đã xào vị trí đáp án. Dữ liệu đáp án đúng được giữ nguyên.')};
$('grade').onclick=()=>{state.graded=true;state.filter='all';state.page=0;render();toast('Đã chấm những câu có đáp án được xác minh.')};
$('reveal').onclick=()=>{let arr=pool();let all=arr.every(q=>state.shown[q.id]);for(let q of arr)state.shown[q.id]=!all;save();render()};
$('reset').onclick=()=>{if(confirm('Xóa toàn bộ câu trả lời của nhóm bài hiện tại? (không xóa các Test khác)')){for(let q of pool()){delete state.answers[q.id];delete state.shown[q.id]}state.graded=false;state.page=0;save();render();toast('Đã xóa kết quả bài này.')}};
$('audioHelp').onclick=()=>alert('Để nghe trên máy tính: tải và giải nén bản ZIP có audio, sau đó mở file HTML nằm trong thư mục vừa giải nén. Trong Test 1–3, bấm ▶ Nghe audio câu này để chọn đúng track. Nếu chỉ mở file HTML riêng lẻ, cần đặt thư mục audio bên cạnh.');
$('mainAudio').addEventListener('error',()=>{$('audioName').textContent='Không tìm thấy MP3. Hãy tải gói ZIP có audio.'});
$('export').onclick=()=>{const s=stat();const o={exportedAt:new Date().toISOString(),test:TESTS[state.test].name,source:state.source,stats:s,answers:pool().map(q=>({set:q.set,n:q.n,selectedIndex:state.answers[q.id]??null,answer:q.answer,correct:q.answer?state.answers[q.id]===q.answer.charCodeAt(0)-65:null}))};let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(o,null,2)],{type:'application/json'}));a.download='TOEIC_'+TESTS[state.test].name.replace(' ','_')+'_ketqua.json';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),2000)};
render();
</script></body></html>