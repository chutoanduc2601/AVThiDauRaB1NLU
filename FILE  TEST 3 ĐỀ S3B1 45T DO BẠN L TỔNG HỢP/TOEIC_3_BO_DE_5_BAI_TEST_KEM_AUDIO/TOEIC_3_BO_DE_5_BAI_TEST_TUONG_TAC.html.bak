<!doctype html><html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>TOEIC Master Practice · 4 bộ đề · 5 bài test</title>
<style>
:root{--bg:#f5f7fb;--ink:#1b2b43;--muted:#68788b;--line:#dfe6f0;--indigo:#315acb;--teal:#077c77;--white:#fff;--ok:#147448;--bad:#b73b32;--warn:#965d08;--soft:#eef3ff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,'Segoe UI',Arial,sans-serif;font-size:15px;line-height:1.55}button,select,input{font:inherit}button{cursor:pointer}button:focus-visible,select:focus-visible,input:focus-visible{outline:3px solid #91adff;outline-offset:2px}
.top{background:#142747;color:white;padding:22px max(18px,calc((100vw - 1180px)/2));box-shadow:0 2px 12px #101d3420}.top h1{font-size:25px;letter-spacing:-.7px;line-height:1.2;margin:0}.top small{display:block;color:#b6c9eb;margin-top:7px}.cap{display:flex;align-items:center;gap:11px}.mini-logo{display:flex;width:45px;height:45px;border-radius:13px;background:#5d7be7;align-items:center;justify-content:center;font-size:25px}.wrap{max-width:1180px;margin:auto;padding:22px 17px 70px}.hero{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:start;margin:0 0 18px}.hero h2{margin:0 0 5px;font-size:23px}.desc{margin:0;color:var(--muted);font-size:14px}.pill{padding:5px 10px;border-radius:30px;background:#e6edff;color:#2350b3;font-weight:700;font-size:12px}.pills{display:flex;gap:7px;flex-wrap:wrap}.tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin:16px 0}.tab{border:1px solid var(--line);background:var(--white);border-radius:12px;padding:12px 8px;text-align:left;color:var(--ink)}.tab strong{display:block;font-size:14px}.tab span{color:var(--muted);font-size:12px}.tab.active{background:#253c7a;color:#fff;border-color:#253c7a}.tab.active span{color:#cbd6f9}
.panel{border:1px solid var(--line);border-radius:14px;background:white;box-shadow:0 1px 3px #2030460b;padding:16px 18px;margin:14px 0}.filters{display:flex;flex-wrap:wrap;align-items:center;gap:9px}.select{padding:9px 12px;border:1px solid #d9e2ef;background:#fff;border-radius:9px;max-width:240px}.controls{display:flex;gap:8px;flex-wrap:wrap}.btn{background:white;color:var(--ink);border:1px solid #cbd5e3;padding:9px 12px;border-radius:9px;font-weight:650;font-size:13px;display:inline-flex;align-items:center;gap:6px;justify-content:center}.btn:hover{background:#f4f7fc}.btn.primary{background:var(--indigo);border-color:var(--indigo);color:white}.btn.primary:hover{background:#254bb9}.btn.warning{border-color:#f0c39c;color:var(--warn)}.btn.danger{border-color:#efb4ae;color:var(--bad)}.btn.small{padding:5px 10px;font-size:12px}.stats{display:flex;gap:17px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--muted)}.stats b{font-size:16px;color:var(--ink)}.progress{height:7px;background:#e8ecf5;border-radius:10px;overflow:hidden;margin-top:10px}.progress div{height:100%;background:#5872d9;width:0;transition:width .25s}.bodygrid{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:19px;align-items:start}.question{background:white;border:1px solid var(--line);border-radius:13px;margin:0 0 14px;padding:18px 20px;box-shadow:0 1px 3px #192e4811}.qhead{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:11px}.qnum{font-weight:850;color:#1e43a0}.meta{background:#f1f4f9;border-radius:7px;padding:2px 7px;font-size:11px;color:#57677a}.meta.pending{background:#fff4e2;color:#966307}.qtitle{font-weight:700;font-size:16px;line-height:1.55;margin-bottom:14px}.options{display:grid;gap:7px}.opt{border:1px solid #dbe2ed;border-radius:9px;padding:10px 12px;display:flex;align-items:start;gap:10px;cursor:pointer;transition:background .13s,border-color .13s}.opt:hover{background:#f5f8ff}.opt.selected{background:#eaf0ff;border-color:#8cafff}.opt.correct{background:#e8f8ed;border-color:#79c995}.opt.incorrect{background:#ffefed;border-color:#e49a8e}.opt input{margin:5px 1px 0 0;accent-color:var(--indigo)}.letter{font-weight:800;color:#465a7a;min-width:20px}.opt-text{flex:1;overflow-wrap:anywhere}.answer-box{border-top:1px dashed var(--line);margin-top:12px;padding-top:12px;font-size:13px}.answer-box strong{color:var(--ok)}.answer-box.pending{color:#875e16}.passage{margin:0 0 15px;background:#f8faff;border-left:3px solid #6981d9;border-radius:7px;padding:10px 13px}.passage summary{cursor:pointer;font-size:13px;font-weight:800;color:#284d9e}.reading{font-family:Georgia,'Times New Roman',serif;white-space:pre-wrap;font-size:14px;line-height:1.65;margin:8px 0 3px;color:#283646}.reading table{font-family:system-ui}.photo{width:100%;max-height:390px;object-fit:contain;display:block;border-radius:8px;margin-bottom:14px;background:#edf1f8}.audio-wrap{display:flex;gap:9px;align-items:center;flex-wrap:wrap}.audio-wrap audio{width:min(100%,470px);height:40px}.small-note{font-size:12px;color:var(--muted)}.sidebar{position:sticky;top:16px}.side-title{font-weight:800;margin:0 0 12px}.navnums{display:grid;grid-template-columns:repeat(5,1fr);gap:5px}.navnum{background:#f5f6fa;border:1px solid #e2e5ef;border-radius:6px;color:#57677d;font-size:11px;padding:7px 0;font-weight:600}.navnum.answered{background:#dce8ff;border-color:#a4bdf4;color:#1747a2}.navnum.current{outline:2px solid #517bdd}.score{display:none;padding:13px 15px;border-radius:9px;background:#f0f5ff;border:1px solid #bdcdf7;margin:10px 0;font-size:14px}.score.show{display:block}.resultStrong{font-size:24px;font-weight:850;color:#174594}.pager{display:flex;align-items:center;justify-content:space-between;gap:14px;margin:18px 0}.notice{border-left:3px solid #e5a64c;background:#fff9e9;padding:10px 13px;font-size:13px;border-radius:8px;color:#74501d}.footer{font-size:12px;color:var(--muted);margin-top:20px}.info-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:8px}.question audio{max-width:100%}.audio-bar{background:#f7f9ff;border:1px solid var(--line);padding:10px;border-radius:10px;margin:12px 0}#toast{position:fixed;bottom:18px;right:16px;background:#1f3150;color:#fff;padding:11px 16px;border-radius:10px;box-shadow:0 5px 23px #0016;display:none;z-index:5}.badge-count{font-variant-numeric:tabular-nums}
@media(max-width:800px){.bodygrid{grid-template-columns:1fr}.sidebar{position:static}.tabs{grid-template-columns:repeat(2,1fr)}.hero{grid-template-columns:1fr}.wrap{padding:13px 10px 50px}.question{padding:14px}.top{padding:18px 15px}.navnums{grid-template-columns:repeat(10,1fr)}.question .qtitle{font-size:15px}}
@media print{header,.controls,.sidebar,.pager,.filters,.tabs,.audio-bar{display:none!important}.question{break-inside:avoid;border:1px solid #aaa}.wrap{max-width:100%}body{background:#fff}}
</style></head><body>
<header class="top"><div class="cap"><div class="mini-logo">✓</div><div><h1>TOEIC Master Practice</h1><small>5 bộ đề · 680 câu · 5 bài test · Tương tác và tự ôn tập</small></div></div></header>
<main class="wrap"><div class="hero"><div><h2 id="currentTitle">Test 1 · Photographs</h2><p class="desc">Gồm cả 3 bộ đề. Xào câu hỏi và đáp án độc lập, vẫn chấm đúng theo lựa chọn gốc.</p></div><div class="pills"><span class="pill">680 questions</span><span class="pill">Offline</span></div></div>
<div class="tabs" id="tabs"></div>
<div class="panel"><div class="info-row"><div class="filters"><label for="setFilter"><b>Nguồn đề:</b></label><select class="select" id="setFilter"><option value="all">Cả 5 bộ đề</option><option value="D1">Chỉ Đề 1</option><option value="D2">Chỉ Đề 2</option><option value="D3">Chỉ Đề 3</option><option value="D4">Chỉ Nguồn đề 4</option><option value="D5">Chỉ Nguồn đề 5</option></select><label for="displayMode"><b>Hiển thị:</b></label><select class="select" id="displayMode"><option value="all">Tất cả câu</option><option value="unanswered">Chưa làm</option><option value="wrong">Câu trả lời sai</option><option value="pending">Đáp án chưa xác minh</option></select></div><div class="controls" style="margin-top:8px"><button class="btn" id="shuffleQ">🔀 Xào câu hỏi</button><button class="btn" id="shuffleA">⇄ Xào đáp án A–D</button><button class="btn primary" id="grade">✓ Chấm bài</button><button class="btn" id="reveal">👁 Xem đáp án</button><button class="btn danger" id="reset">↺ Làm lại</button></div></div><div class="stats" id="stats" style="margin-top:12px"></div><div class="progress"><div id="bar"></div></div><div class="score" id="score"></div></div>
<div class="panel" id="audioPanel" style="display:none"><div class="info-row"><div><b>🎧 Listening</b> <span class="small-note" id="audioText"></span></div><div class="controls"><button id="audioHelp" class="btn small">Cách dùng audio</button></div></div><div class="audio-bar"><audio controls preload="none" id="mainAudio"></audio><span class="small-note" id="audioName"></span></div></div>
<div class="bodygrid"><div><div class="notice" id="notice">Những câu thiếu bản chép âm thanh hoặc đáp án đã được đánh dấu, không tự chấm bừa.</div><div id="questions"></div><div class="pager"><button class="btn" id="prev">← Trang trước</button><span id="pageInfo" class="small-note"></span><button class="btn" id="next">Trang sau →</button></div></div><aside class="sidebar"><div class="panel"><div class="side-title">Điều hướng câu hỏi</div><div id="navigator" class="navnums"></div><p class="small-note">Xanh: đã chọn · Viền xanh: trang hiện tại</p><button id="export" class="btn small" style="width:100%;margin-top:8px">⬇ Xuất kết quả JSON</button></div><div class="panel"><b>Lưu ý về đề</b><p class="small-note">Các câu trong cùng đoạn văn/hội thoại sẽ được giữ theo nhóm khi xào thứ tự.</p><p class="small-note">Đề 2, câu 1–9 Part 1 và câu 11–40 Part 2 đã được cập nhật script từ audio. Tất cả câu đã xác minh.</p><p class="small-note">Nguồn đề 4: 40 câu Part 5 từ Nông Lâm Test 4 (câu 101–140). Đáp án và giải thích ngữ pháp đã xác minh.</p><p class="small-note">Nguồn đề 5: 40 câu Part 5 từ Nông Lâm Test 1 (câu 101–140). Đáp án và giải thích ngữ pháp đã xác minh.</p></div></aside></div>
<p class="footer">Dữ liệu tổng hợp từ các PDF/audio người học cung cấp và các đoạn đối chiếu đã đọc. Ứng dụng nhằm mục đích tự học, không phải đáp án chính thức do ETS phát hành. Khi dùng audio, tải gói offline hoặc chọn tệp MP3 tương ứng.</p>
</main><div id="toast" role="status"></div><script>const DB={"sets":[{"id":"D1","label":"Đề 1 · Longman Practice Test Two","short":"Đề 1"},{"id":"D2","label":"Đề 2 · Nông Lâm Test of English","short":"Đề 2"},{"id":"D3","label":"Đề 3 · Longman Practice Test One","short":"Đề 3"},{"id":"D4","label":"Nguồn đề 4 · Nông Lâm Test 4","short":"Đề 4"},{"id":"D5","label":"Nguồn đề 5 · Nông Lâm Test 1","short":"Đề 5"}],"questions":[{"id":"D1-001","set":"D1","n":1,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Singers performing on stage","Scientists examining samples","People sitting around a conference table","People appearing in court"],"answer":"C","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"1","passage":null,"confidence":"review"},{"id":"D1-002","set":"D1","n":2,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["People gardening outdoors","Two women eating lunch","Cooks preparing food","Workers harvesting crops"],"answer":"B","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"2","passage":null,"confidence":"review"},{"id":"D1-003","set":"D1","n":3,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["An eye examination","Speaking into a microphone","Working with a microscope","Putting laboratory tools away"],"answer":"C","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"3","passage":null,"confidence":"review"},{"id":"D1-004","set":"D1","n":4,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Flight attendants serving meals","Travelers boarding an airplane","An airplane taking off","A train at the station"],"answer":"B","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"4","passage":null,"confidence":"review"},{"id":"D1-005","set":"D1","n":5,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Writing down an address","Shopping for clothing","A speaker addressing an audience","Loudspeakers filling the room"],"answer":"C","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"5","passage":null,"confidence":"review"},{"id":"D1-006","set":"D1","n":6,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Cleaning a painting","Visitors looking at artwork","Exhibiting photographs","Children drawing pictures"],"answer":"B","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"6","passage":null,"confidence":"review"},{"id":"D1-007","set":"D1","n":7,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Conducting an orchestra","Searching for a hat","Wearing protective laboratory gear","Sewing clothing"],"answer":"C","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"7","passage":null,"confidence":"review"},{"id":"D1-008","set":"D1","n":8,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["A train stopped beside a platform","A plane waiting on a runway","Passengers sitting in a waiting room","Rain falling on the station"],"answer":"A","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"8","passage":null,"confidence":"review"},{"id":"D1-009","set":"D1","n":9,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["Two athletes playing on a field","Playing a board game","People at a fruit market","A balloon flying overhead"],"answer":"A","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"9","passage":null,"confidence":"review"},{"id":"D1-010","set":"D1","n":10,"part":1,"q":"Which statement best describes the photograph? (English alternatives are study paraphrases, not a verbatim transcript.)","options":["People riding in a taxi","Two people shaking hands","Employees distributing laptops","People walking outdoors"],"answer":"B","explanation":"Mô tả tương ứng với hành động/vật thể trong ảnh.","group":"10","passage":null,"confidence":"review"},{"id":"D1-011","set":"D1","n":11,"part":2,"q":"Why does he visit Spain every summer?","options":["Because he has relatives who live there.","The springs are so mild there.","Tourism is their number one industry."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"11","passage":null,"confidence":"review"},{"id":"D1-012","set":"D1","n":12,"part":2,"q":"How much does this book cost?","options":["We are not taking reservations right now.","It’s $22.","It reads quickly."],"answer":"B","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"12","passage":null,"confidence":"review"},{"id":"D1-013","set":"D1","n":13,"part":2,"q":"Who left their coffee on my desk?","options":["I don’t know.","I always have a cup of coffee in the afternoon.","My desk is so cluttered."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"13","passage":null,"confidence":"review"},{"id":"D1-014","set":"D1","n":14,"part":2,"q":"Too much staff is working right now.","options":["We’ll start working in a few minutes.","They’re driving, not walking.","I’ll send two people home."],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"14","passage":null,"confidence":"review"},{"id":"D1-015","set":"D1","n":15,"part":2,"q":"When does the express train run?","options":["It is the fastest.","We usually go jogging every other day.","It leaves here on the hour."],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"15","passage":null,"confidence":"review"},{"id":"D1-016","set":"D1","n":16,"part":2,"q":"Could you tell me how to get to the National Museum?","options":["Take the orange line to the first subway stop.","It is far away from here.","It has many priceless pieces of art."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"16","passage":null,"confidence":"review"},{"id":"D1-017","set":"D1","n":17,"part":2,"q":"I think Marcy is ready to become a store manager.","options":["Does she have the money to buy it?","Wasn’t Ellen in charge yesterday?","Do you think she has enough experience?"],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"17","passage":null,"confidence":"review"},{"id":"D1-018","set":"D1","n":18,"part":2,"q":"What kind of books do you read?","options":["I like nonfiction.","I go to the library.","I like to read before I go to bed."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"18","passage":null,"confidence":"review"},{"id":"D1-019","set":"D1","n":19,"part":2,"q":"Why don’t we look over these figures?","options":["I am on a diet.","I can’t do that right now.","Maybe you can see."],"answer":"B","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"19","passage":null,"confidence":"review"},{"id":"D1-020","set":"D1","n":20,"part":2,"q":"Whose shoes are these?","options":["I find them quite easy.","We might have to sue them.","They’re mine."],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"20","passage":null,"confidence":"review"},{"id":"D1-021","set":"D1","n":21,"part":2,"q":"Where is the television cable?","options":["It’s on the workbench.","I like to watch TV when I get home.","We should be able to help you."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"21","passage":null,"confidence":"review"},{"id":"D1-022","set":"D1","n":22,"part":2,"q":"What is your personal identification number?","options":["Our address is 125 North 52nd Street.","It’s 3256.","The personnel department handles employee problems."],"answer":"B","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"22","passage":null,"confidence":"review"},{"id":"D1-023","set":"D1","n":23,"part":2,"q":"What did you do with the inventory sheets?","options":["They’re on my desk.","We haven’t made the beds.","We came up with many new innovations."],"answer":"A","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"23","passage":null,"confidence":"review"},{"id":"D1-024","set":"D1","n":24,"part":2,"q":"What kind of dressing would you like on your salad?","options":["That probably is too big for me.","I prefer to wear work pants.","Oil and vinegar will be fine."],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"24","passage":null,"confidence":"review"},{"id":"D1-025","set":"D1","n":25,"part":2,"q":"Can you take me to the airport?","options":["Most flights leave before 8:00 p.m.","Yes, but it will cost you an extra $5.","The air pollution is worse in the summer."],"answer":"B","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"25","passage":null,"confidence":"review"},{"id":"D1-026","set":"D1","n":26,"part":2,"q":"Is there anyone who can translate this?","options":["The order will be transported to another branch.","No one has a watch.","Maybe Mr. Baker can."],"answer":"C","explanation":"Phản hồi đáp ứng đúng nội dung câu hỏi hoặc lời đề nghị.","group":"26","passage":null,"confidence":"review"},{"id":"D1-027","set":"D1","n":27,"part":2,"q":"I’m not g